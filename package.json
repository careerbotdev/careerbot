{
  "name": "careerbot",
  "version": "0.9.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm share:card && next build",
    "start": "next start",
    "lint": "eslint && node scripts/design-check.mjs && node scripts/explainer-audit.mjs && node scripts/tour-check.mjs && tsx scripts/docs-check.ts && tsx scripts/release.ts check",
    "docs:gen": "tsx scripts/docs-gen.ts",
    "docs:shots": "tsx scripts/docs-shots.ts",
    "design:check": "node scripts/design-check.mjs",
    "dev:convex": "convex dev",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "tokens": "node scripts/tokens.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static --quiet",
    "check:rendered": "playwright test -c tests/rendered",
    "check:worker": "playwright test -c tests/worker",
    "arch": "likec4 start docs/architecture",
    "arch:check": "depcruise src convex --config .dependency-cruiser.cjs && likec4 validate docs/architecture && node scripts/arch-check.mjs",
    "arch:build": "likec4 build docs/architecture -o architecture-static",
    "share:card": "tsx scripts/share-card.tsx",
    "personas:run": "tsx scripts/personas.ts",
    "demo": "tsx --conditions=import scripts/demo.ts",
    "release:notes": "tsx scripts/release-notes.ts",
    "release:version": "tsx scripts/release.ts version",
    "release:prepare": "tsx scripts/release.ts prepare",
    "changes:check": "tsx scripts/release.ts check",
    "upgrade:check": "tsx scripts/upgrade-check.ts"
  },
  "dependencies": {
    "@auth/core": "~0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "cmdk": "^1.1.1",
    "convex": "^1.46.0",
    "docx": "^9.7.2",
    "driver.js": "^1.8.0",
    "fumadocs-core": "^16.15.17",
    "fumadocs-mdx": "^15.4.5",
    "jszip": "^3.10.2",
    "libphonenumber-js": "^1.13.14",
    "lucia": "3.2.2",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.6",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.14.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@fontsource/inter": "5.3.0",
    "@google/design.md": "^0.4.0",
    "@opennextjs/cloudflare": "^1.20.7",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "convex-test": "^0.0.59",
    "dependency-cruiser": "18.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "likec4": "1.59.4",
    "storybook": "^10.6.0",
    "tailwindcss": "^4",
    "takumi-js": "2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.144.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.12.4"
}
