  }
  careerbot.platform.enrich -[writes]-> careerbot.data.tCompanies 'details with sources'
  careerbot.platform.enrich -[uses]-> careerbot.platform.metering 'AI call; Apollo job postings if turned on'

  // ---- Finding roles ----
  careerbot.platform.watchRoles -[uses]-> careerbot.platform.jobs 'runs as a job'
  careerbot.platform.watchRoles -[reads]-> careerbot.data.tCompanies 'Targets and Maybe companies with their job board'
  careerbot.platform.watchRoles -[writes]-> careerbot.data.tCompanies 'coverage: last read, roles read, board total'
  careerbot.platform.watchRoles -[calls]-> companyWebsites 'job board listings and job detail pages; public hostnames only'
  careerbot.platform.watchRoles -[uses]-> careerbot.platform.metering 'Apollo job postings, only while turned on'
  careerbot.platform.watchRoles -[reads]-> careerbot.data.tItems.directions 'approved directions (titles to search Workday and Oracle; when each last changed, to mark roles ranked before it); approved Location limit; approved Eligibility limits, checked against what judged roles state (no AI) to set them apart or rank them lower; firm ones start the clearance and visa filters' {
    #approvedOnly
  }
  careerbot.platform.watchRoles -[writes]-> careerbot.data.tPostings 'roles, seen and closed; what each board states about them; next step, claims and failures; directions to rank again'
  careerbot.platform.watchRoles -[uses]-> careerbot.core.roleDetailsSchema 'board details, merging, yearly pay'
  careerbot.platform.watchRoles -[writes]-> careerbot.data.tPostingTexts 'full descriptions'
