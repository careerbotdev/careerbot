  careerbot.platform.enrich -[uses]-> careerbot.platform.braveKey 'job board search fallback'
  careerbot.ui.settingsScreen -[calls]-> careerbot.platform.braveKey
  careerbot.platform.enrich -[reads]-> careerbot.data.tItems.directions 'approved directions (titles, positioning, criteria) and approved limits' {
