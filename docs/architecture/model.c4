  careerbot.core.duplicatesApi -[writes]-> careerbot.data.tItems.context 'notes move to the kept fact'

  careerbot.ai.compare -[reads]-> careerbot.data.tNarratives 'one career narrative, without the record' {
    #rawNarrative
  }
  careerbot.ai.compare -[writes]-> careerbot.data.tComparisons 'each contender’s output, cost, time'

  careerbot.ai.firstCall -[writes]-> careerbot.data.tJobs 'the reply'

  // ---- Review and data ----
