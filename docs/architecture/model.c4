  careerbot.ui.today -[calls]-> careerbot.platform.aiSettings 'Getting started: the main model'

  // ---- Google Drive and ratings (M6 finish) ----
  careerbot.ui.settingsScreen -[calls]-> careerbot.pursue.driveApi 'Google Drive: connect, folder, sync, disconnect'
  careerbot.ui.resumeScreen -[calls]-> careerbot.pursue.driveApi 'In Drive: status and link'
  careerbot.pursue.driveApi -[calls]-> googleDrive 'create and update Docs and folders'
  careerbot.pursue.driveApi -[reads]-> careerbot.data.tResumes 'kept versions to write'
  careerbot.pursue.driveApi -[reads]-> careerbot.data.tPursuits 'letters, answers, and whether it was sent'
  careerbot.pursue.driveApi -[writes]-> careerbot.data.tDriveFiles
  careerbot.pursue.driveApi -[writes]-> careerbot.data.tDriveConnections
  careerbot.platform.discovery -[reads]-> careerbot.data.tCompanies 'Targets as lookalike seeds; Not for me never found again (while Learn from your ratings is on)'
  careerbot.platform.enrich -[reads]-> careerbot.data.tCompanies 'companies they turned down, and why, as preferences' {
    #rejectedAsGuard
  }
  careerbot.platform.rankRoles -[reads]-> careerbot.data.tPostings 'roles they turned down, and why, as preferences, never limits' {
    #rejectedAsGuard
  }
  careerbot.ui.resumeScreen -[calls]-> careerbot.ai.lineCheck 'Check against facts on a line or summary in their words; Supported or Goes beyond with the words that do'
  careerbot.ui.resumeScreen -[calls]-> careerbot.pursue.estimatesApi 'cost beside Check against facts'
  careerbot.ai.lineCheck -[reads]-> careerbot.data.tItems.facts 'the approved facts the line (or the resume, for the summary) rests on that still count' {
    #approvedOnly
  }
  careerbot.ai.lineCheck -[reads]-> careerbot.data.tResumes 'their words and where the line sits'
  careerbot.ai.lineCheck -[writes]-> careerbot.data.tResumes 'the answer, with the words and the facts it checked'
  careerbot.ai.lineCheck -[reads]-> careerbot.data.tJobs 'which lines are being checked'
  careerbot.ai.lineCheck -[uses]-> careerbot.platform.metering 'AI call'

  // ---- Fact changes flow to documents (M7) ----
  careerbot.ui.resumeScreen -[calls]-> careerbot.ai.lineUpdate 'lines resting on changed facts; Update lines, Apply, Discard, Use the new line'
  careerbot.ui.pursuitScreen -[calls]-> careerbot.ai.lineUpdate 'the tailored resume, letter and answers: lines resting on changed facts'
  careerbot.ui.today -[calls]-> careerbot.ai.lineUpdate 'documents in use resting on changed facts, in the Resumes group'
  careerbot.ui.resumeScreen -[calls]-> careerbot.pursue.estimatesApi 'cost beside Update lines'
  careerbot.ai.lineUpdate -[reads]-> careerbot.data.tItems.facts 'the approved facts the lines cite that still count: as they read now and, from their history, as the lines were written' {
    #approvedOnly
  }
  // Decision: a rejected fact a line cites is read too, so the new line can drop what rested on it; never as a source.
  careerbot.ai.lineUpdate -[reads]-> careerbot.data.tItems.facts 'a rejected fact a line cites: its words, as what to take out' {
    #rejectedAsGuard
  }
  careerbot.ai.lineUpdate -[reads]-> careerbot.data.tResumes 'the resume in use: its lines, their own words, what it was written from'
  careerbot.ai.lineUpdate -[writes]-> careerbot.data.tResumes 'the updated lines, pins, hides and own words that follow them, the facts as they read'
  careerbot.ai.lineUpdate -[reads]-> careerbot.data.tLetters 'the newest version of a letter not sent'
  careerbot.ai.lineUpdate -[writes]-> careerbot.data.tLetters 'a new version with the updated paragraphs'
  careerbot.ai.lineUpdate -[reads]-> careerbot.data.tPursuits 'answers, and whether it was sent (sent: left alone)'
  careerbot.ai.lineUpdate -[writes]-> careerbot.data.tPursuits 'updated answers; the timeline'
  careerbot.ai.lineUpdate -[writes]-> careerbot.data.tLineUpdates 'the new lines to apply or discard'
  careerbot.ai.lineUpdate -[reads]-> careerbot.data.tJobs 'whether a document\u2019s lines are being updated'
  careerbot.ai.lineUpdate -[uses]-> careerbot.platform.metering 'AI call'
}
