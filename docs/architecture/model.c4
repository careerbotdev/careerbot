      }
      notesApi = service 'Notes' {
        description 'Notes on a pursuit, a company, a role not started or anything in the record, in their own words, dated, oldest first: list, add (a pursuit\u2019s goes on its timeline), edit, remove, only within their workspace. Never evidence: no AI step reads them.'
        metadata {
          functions 'notes:list, notes:add, notes:edit, notes:remove'
        }
      }
      reportsApi = service 'Reports' {
        description 'overview, spending, search, outcomes, record and activity for a period (month, quarter, all; UTC), read from running totals kept where events happen (spendTotals, tallies) so no report scans every row; search and outcomes read the pursuits active in the period. A reply: a contact marked replied, or a move to In conversation, Interviewing or Offer, or Closed as rejected or declined; time to first reply runs from the first outreach message or the application. Contacted and Applied are counted apart and together (pursuitSteps.wentOut; a pursuit can be both) in overview, search and outcomes. outcomes: how far each pursuit got by direction (interviews of those contacted or applied) and, for applications, by the direction resume version its tailored resume was written from (the one current when it was written); replies by path (Apply, Outreach, both) and by contact group; with deterministic suggestions (pursuitSteps.outcomeSuggestions: enough pursuits contacted or applied, applications or pursuits on a path to compare, a clear lead); no AI, nothing changes. backfill counts existing rows once (operator).'
        metadata {
          functions 'reports:overview, reports:spending, reports:search, reports:outcomes, reports:record, reports:activity, reports:backfill, reports:backfillAll, tallies:fold'
        }
      }
      estimatesApi = service 'Estimates' {
        description 'costs: what an action is likely to cost from what the same kind of work has cost them so far, shown beside it before they choose.'
        metadata {
          functions 'estimates:costs'
        }
      }
    }

    data = area 'Tables' {
      tWorkspaces = table 'workspaces' {
        metadata {
          table 'workspaces'
        }
      }
      tMemberships = table 'memberships' {
        metadata {
          table 'memberships'
        }
      }
      tUsers = table 'users' {
        description 'Convex Auth\u2019s people; on a self-hosted copy also their username, whether they are the owner, whether their password is a temporary one, and when they last signed in.'
        metadata {
          table 'users'
        }
      }
      tSetupCodes = table 'setupCodes' {
        description 'A self-hosted copy\u2019s setup codes, hashed: when one was used, and how many wrong tries it has had.'
        metadata {
          table 'setupCodes'
        }
      }
      tUpdateCheck = table 'updateCheck' {
        description 'A self-hosted copy\u2019s check for a new version, one row: whether its owner turned it off, when the list was last read, and the releases newer than the copy then.'
        metadata {
          table 'updateCheck'
        }
      }
      tApiKeys = table 'apiKeys' {
        metadata {
          table 'apiKeys'
        }
      }
      tUsage = table 'usage' {
        description 'One row per paid call; reserved (holding the most an AI call could cost) then settled.'
        metadata {
          table 'usage'
        }
      }
      tAiSpend = table 'aiSpend' {
        description 'Each workspace\u2019s AI spending per month as a running total, in shards: what was settled and what calls not settled yet hold, read by the budget check instead of every call of the month.'
        metadata {
          table 'aiSpend'
        }
      }
      tModelPrices = table 'modelPrices' {
        description 'Each AI model\u2019s highest prices, longest reply and context across its providers, what AI calls reserve against the budget; and whether a provider of it keeps to a JSON schema.'
        metadata {
          table 'modelPrices'
        }
      }
      tBudgets = table 'budgets' {
        metadata {
          table 'budgets'
        }
      }
      tJobs = table 'jobs' {
        metadata {
          table 'jobs'
        }
      }
      tNarratives = table 'narratives' {
        description 'A person’s own account of a job, project or what they want next, with its version; rejectedAt when they rejected it as a source.'
        metadata {
          table 'narratives'
        }
      }
      tNarrativeVersions = table 'narrativeVersions' {
        metadata {
          table 'narrativeVersions'
        }
      }
      tItems = table 'items' {
        description 'Everything understood about the person, by kind (role, fact, context, direction, limit, conflict) and status (proposed, approved, rejected, skipped, superseded, setAside: unreviewed when its narrative or project was rejected). sources: the narratives and versions it rests on (several once another narrative says the same); it counts while any of them, or its approved project, stands.'
        metadata {
          table 'items'
        }
        roles = table 'roles' {
          description 'kind role: employer, titles, dates, skills. A career break is a role with break set: dates and the person’s own reason, no employer.'
        }
        facts = table 'facts' {
          description 'kind fact: one line each, with history, suggestion, rejection reason, duplicate flag, facts kept apart from it, and what it was merged into. A project’s facts carry its projectKey and the files they rest on, and same work: a suggested pair (on the project’s fact), a connected pair with its lead (on both), and the role’s facts kept separate from it.'
        }
        projectsKind = table 'projects' {
          description 'kind project: one of their repositories: name, repository and link, private, description, languages, first and last commit (YYYY-MM), commit count (from GitHub); summary and stack (read); edited; projectKey; roleKey is the role it is linked to.'
        }
        context = table 'context' {
          description 'kind context: background that sharpens facts; from notes and details left out of a line.'
        }
        directions = table 'directions' {
          description 'kind direction: banner, includes, summary, fit; when what ranking roles reads last changed.'
        }
        limits = table 'limits' {
          description 'kind limit: bucket, value, firm, scope, condition, typed rule, note.'
        }
        skillsKind = table 'skills' {
          description 'kinds skill, tool, certification: name, group, from (roleKeys, projectKeys, fact ids where the record shows it), low-value reason, sameAs (a merge to decide), kept apart, merged into, edited, rejection reason. Counts while one of its sources counts (sourceCheck).'
        }
        insightsKind = table 'insights' {
          description 'kind insight: text, cited approved factIds, rejection reason.'
        }
        followupsKind = table 'follow-ups' {
          description 'kind followup: question, why, fact or role, answer and where it went.'
        }
        questions = table 'questions' {
          description 'kind conflict: where a narrative disagrees with the record, and the answer.'
        }
      }
      tAiSettings = table 'aiSettings' {
        metadata {
          table 'aiSettings'
        }
      }
      tResumes = table 'resumes' {
        description 'Every version: doc (as written, with projects and skills keyed to their approved items), layout (where it differs from the resume settings: folds, breaks, projects and skills shown or left out on every level, titles on direction and tailored), posting (and the role it came from on the Roles page) and requirements map, titles suggested for the posting; writtenFrom (base and direction: what it was written from, resumeBasis); toReview (written from Resume updates, waiting to be kept or discarded). Older versions keep only counts (basedOn), never read.'
        metadata {
          table 'resumes'
        }
      }
      tResumeSettings = table 'resumeSettings' {
        description 'One per workspace: how each role, project and skill shows on every resume. Folds, career breaks (shown, reason shown, left out), and projects and skills left out, set on the record; titles set on the base resume.'
        metadata {
          table 'resumeSettings'
        }
      }
      tPursuits = table 'pursuits' {
        description 'A role they are going after, or a company they write to with no open role (no posting; titled with what they are after): its role and company (copied when started), direction, score and level then, status and why it closed, the path they chose (Apply, Outreach or both), their next step and notes, the first Contacted, Applied and reply dates, the tailored resume it uses, what was sent (the resume as shown, the cover letter and the answers when it left Preparing), a dated timeline of every change, and its last activity.'
        metadata {
          table 'pursuits'
        }
      }
      tContacts = table 'contacts' {
        description 'People found at a pursuit\u2019s company: Apollo id, name, title, likely hiring manager, the group they moved them to (else worked out from the title), no Apollo id for someone they added by hand, email and LinkedIn once revealed (when), an outreach draft with the approved facts it rests on, and every message they marked sent exactly as it was (subject, text, to whom, when), never changed by a later draft.'
        metadata {
          table 'contacts'
        }
      }
      tReminderSettings = table 'reminderSettings' {
        description 'Which reminders a workspace wants: Follow up, Prepare, Check in. No row: all on.'
        metadata {
          table 'reminderSettings'
        }
      }
      tPursuitMessages = table 'pursuitMessages' {
        description 'Ask about this role, per pursuit: their messages (with the note one became when it told something new) and the answers (with the approved facts each rests on, whether it was kept, the run that wrote it).'
        metadata {
          table 'pursuitMessages'
        }
      }
      tLetters = table 'letters' {
        description 'Cover letter versions per pursuit: paragraphs with the approved facts each rests on, whether it is their own wording, the resume it was written with, model, run, when.'
        metadata {
          table 'letters'
        }
      }
      tLineUpdates = table 'lineUpdates' {
        description 'Line updates waiting to apply or discard, one per document (a resume, a cover letter or a pursuit\u2019s answers): each line as it was (with the facts it cited and their own words for it), what it becomes with the facts it rests on now, and whether to use it; the cited facts\u2019 marks as they read when written, and which cited facts didn\u2019t count then; the run.'
        metadata {
          table 'lineUpdates'
        }
      }
      tProfiles = table 'profiles' {
        metadata {
          table 'profiles'
        }
      }
      tCompanies = table 'companies' {
        metadata {
          table 'companies'
        }
      }
      tDiscovery = table 'discovery' {
        description 'Default seed websites and their Apollo ids; how roles are sorted before judging (AI model or Jev); whether judging counts how big a stretch a role is (rubric v2; unset is on); when roles passes were stopped; failures in the current roles pass that were not about any one role.'
        metadata {
          table 'discovery'
        }
      }
      tPostings = table 'postings' {
        description 'Every role read from the boards of Targets and Maybe companies: board id, link, the board’s own application link when it gives one, title, location, dates seen and closed; what its board states (board details: pay, setup, employment type, locations); what judging read from its description (details) and its brief (job, for you); the quick sort (directions it could be, every direction sorted against with when it last changed, method); fit per judged direction (level, score, reason, method, what sorted it there, when the direction last changed, the rubric it was scored by and, under v2, its stretch); directions to rank again; a pass\u2019s next step for it with its random spot in that step\u2019s queue (given when first queued), the worker holding it and failures; the person\u2019s rating.'
        metadata {
          table 'postings'
        }
      }
      tPostingTexts = table 'postingTexts' {
        description 'A role\u2019s full description as plain text, as read, and the same without what its company repeats across its postings (what the AI reads). Kept apart so lists of roles stay small.'
        metadata {
          table 'postingTexts'
        }
      }
      tRoleRanks = table 'roleRanks' {
        description 'Where each listed role stands for each approved direction, and for all of them together (its best verdict): judged (level, score), sorted out, or against (judged, but what it states is against a firm eligibility limit: a clearance above the one they hold, or no visa sponsorship when they need it; or outside a firm location limit: a setup or place they won’t work; set apart from the list, with the reason in words); meetsPreferences (false when against such a limit, firm or a preference, so it ranks after the rest); and what the Roles page filters on, copied from the role, its details (board first) and its company: rating, company rating, pay as yearly US dollars, setup, seniority, employment type, years asked, travel, clearance, visa, places and their countries, posted and newest dates; when the direction last changed as of its ranking. Derived from postings and kept in step with them, so the Roles page reads a page at a time, best score first, filtered.'
        metadata {
          table 'roleRanks'
        }
      }
      tRubricRuns = table 'rubricRuns' {
        description 'A rubric tried on a sample of a workspace\u2019s judged roles before it is applied: the rubric, when, status, the sample size, what the calls cost, roles that failed; one row per role and direction with its live verdict (level, score, reason) beside the new one (level, score, reason, stretch). Live verdicts are never touched.'
        metadata {
          table 'rubricRuns'
        }
      }
      tGithubApp = table 'githubApp' {
        description 'CareerBot’s GitHub App: id, slug, client id, owner; private key, client secret and webhook secret sealed. One row.'
        metadata {
          table 'githubApp'
        }
      }
      tGithubInstalls = table 'githubInstalls' {
        description 'A workspace’s GitHub connection: the installation id, its account, all or selected repositories, and where to change them on GitHub.'
        metadata {
          table 'githubInstalls'
        }
      }
      tGithubLinks = table 'githubLinks' {
        description 'One-time links for GitHub’s round trips, each good for a short while: creating the app (operator), or connecting a workspace (with the installation held until GitHub confirms it is theirs).'
        metadata {
          table 'githubLinks'
        }
      }
      tAiDefaults = table 'aiDefaults' {
        description 'Each workspace\u2019s main model and reasoning, used by every task without its own.'
        metadata {
          table 'aiDefaults'
        }
      }
      tSpendTotals = table 'spendTotals' {
        description 'Running spend per workspace, month, task, area, who started it and pursuit, for Reports.'
        metadata {
          table 'spendTotals'
        }
      }
      tTallies = table 'tallies' {
        description 'Running counts per workspace and day (companies found and targets, roles by fit, facts approved, resume versions, work done and failed), for Reports. Each change is a row of its own, written without reading a count, so writes at once never collide; tallies:fold folds them into one row per count and day every 5 minutes.'
        metadata {
          table 'tallies'
        }
      }
      tComparisons = table 'comparisons' {
        metadata {
          table 'comparisons'
        }
      }
      tDriveConnections = table 'driveConnections' {
        description 'Each workspace\u2019s Google Drive connection: account, sealed tokens, the CareerBot folder, and whether it is broken.'
        metadata {
          table 'driveConnections'
        }
      }
      tDriveFiles = table 'driveFiles' {
        description 'Each file CareerBot keeps in Drive: what it is for (base, direction, tailored resume, letter, answers), its Drive id and folder, the content it last wrote, when, and any failure.'
        metadata {
          table 'driveFiles'
        }
      }
      tDriveLinks = table 'driveLinks' {
        description 'One-time links that start a Drive connection, bound to the browser, with where it began (Settings, or Getting started on Today), so Google comes back there.'
        metadata {
          table 'driveLinks'
        }
      }
      tNotes = table 'notes' {
        description 'Their own notes on a pursuit, company, role or record item: text, when, when edited. Never read by an AI step.'
        metadata {
          table 'notes'
        }
      }
      tExports = table 'exports' {
        description 'A workspace\u2019s export: running (what it is on, how far), done (the ZIP in file storage, its name and size, when it goes) or failed. One per workspace; deleted with its ZIP an hour after it is made.'
        metadata {
          table 'exports'
        }
      }
      tImports = table 'imports' {
        description 'A workspace\u2019s import: the uploaded ZIP, checking, ready with its preview (format, CareerBot version, when exported, counts by kind) or refused with why, importing (the kind going in, rows in so far, a last sign of life), done with its result, or failed. One per workspace.'
        metadata {
          table 'imports'
        }
      }
      tImportIds = table 'importIds' {
        description 'While an import runs: each row and stored file put in, by its id in the file and here, with fields still to patch in; written with the row, so a continued import never puts one in twice. Deleted once it is done.'
        metadata {
          table 'importIds'
        }
      }
      tFollowUps = table 'followUps' {
        description 'A pursuit\u2019s follow-up: the draft, a rewrite waiting to be kept, and every one marked sent, kept exactly as it was (to whom, when), with the approved facts it rests on.'
        metadata {
          table 'followUps'
        }
      }
      tWaitlist = table 'waitlist' {
        description 'Emails left on the website to hear when CareerBot opens up: when, and where on the page. Not tied to a workspace.'
        metadata {
          table 'waitlist'
        }
      }
    }
  }

  // ---- People and screens ----
  person -> careerbot.ui 'uses'
  person -> oauth 'signs in with'
  operator -> careerbot.platform.admin 'runs'
  careerbot.platform.auth -[uses]-> oauth

  careerbot.ui.narrativesScreen -[calls]-> careerbot.core.narrativesApi
  careerbot.ui.narrativesScreen -[calls]-> careerbot.ai.extract 'Read this narrative'
  careerbot.ui.narrativesScreen -[calls]-> careerbot.ai.goalsRead 'Read my goals'
  careerbot.ui.recordScreen -[calls]-> careerbot.core.reviewApi
  careerbot.ui.recordScreen -[calls]-> careerbot.ai.rework 'Ask for a rewrite / Add context'
  careerbot.ui.recordScreen -[calls]-> careerbot.ai.check 'Check for disagreements'
  careerbot.ui.recordScreen -[calls]-> careerbot.core.questionsApi
  careerbot.ui.recordScreen -[calls]-> careerbot.ai.duplicatesStep 'Find duplicates'
  careerbot.ui.recordScreen -[calls]-> careerbot.core.duplicatesApi 'Merge, Keep both'
  careerbot.ui.recordScreen -[calls]-> careerbot.core.resumeApi 'Fold menu: how each role and break shows on every resume'
  careerbot.ui.recordScreen -[calls]-> careerbot.core.breaksApi 'Add a career break, Edit'
  careerbot.core.breaksApi -[writes]-> careerbot.data.tItems.roles 'career breaks'
  careerbot.ui.goalsScreen -[calls]-> careerbot.core.goalsApi
  careerbot.ui.goalsScreen -[uses]-> careerbot.core.limitSchema 'fields, rows'
  careerbot.ui.compareScreen -[calls]-> careerbot.ai.compare
  careerbot.ui.compareScreen -[calls]-> careerbot.core.compareApi
  careerbot.ui.settingsScreen -[calls]-> careerbot.platform.keys
  careerbot.ui.settingsScreen -[calls]-> careerbot.platform.aiSettings
  careerbot.ui.settingsScreen -[calls]-> careerbot.platform.budgetsApi
  careerbot.ui.settingsScreen -[calls]-> careerbot.ai.firstCall

  // ---- Every AI step runs as a job and through metering ----
  careerbot.ai -[uses]-> careerbot.platform.jobs 'runs as a job'
  careerbot.ai -[uses]-> careerbot.platform.metering 'every call'
  careerbot.ai -[uses]-> careerbot.platform.aiSettings 'model for its task'
  careerbot.platform.metering -[calls]-> openrouter
  careerbot.platform.metering -[reads]-> careerbot.platform.keys 'unseals the key'
  careerbot.platform.metering -[writes]-> careerbot.data.tUsage
  careerbot.platform.metering -[reads]-> careerbot.data.tBudgets
  careerbot.platform.metering -[reads]-> careerbot.data.tAiSpend 'this month\u2019s settled and held AI spending, before each call'
  careerbot.platform.metering -[writes]-> careerbot.data.tAiSpend 'each call\u2019s reservation, then its cost'
  careerbot.platform.metering -[uses]-> careerbot.platform.modelPrices 'price of the call\u2019s model'
  careerbot.platform.metering -[calls]-> careerbot.platform.jobs 'a settled call restarts work waiting on what it held'
  careerbot.platform.modelPrices -[calls]-> openrouter 'each model\u2019s endpoints and their prices'
  careerbot.platform.modelPrices -[writes]-> careerbot.data.tModelPrices
  careerbot.platform.jobs -[reads]-> careerbot.data.tAiSpend 'whether calls still hold the budget, before pausing for them'
  careerbot.platform.jobs -[writes]-> careerbot.data.tJobs
  careerbot.platform.crons -[calls]-> careerbot.platform.jobs 'resume paused; recover interrupted'
  careerbot.platform.crons -[calls]-> careerbot.platform.watchRoles 'daily roles pass'
  careerbot.platform.crons -[calls]-> careerbot.platform.modelPrices 'hourly: model prices'

  // ---- Inputs and outputs of each AI step (the part that decides quality downstream) ----
  careerbot.ai.extract -[reads]-> careerbot.data.tNarratives 'the one career narrative' {
    #rawNarrative
  }
  careerbot.ai.extract -[reads]-> careerbot.data.tItems.facts 'confirmed roles and facts' {
    #approvedOnly
    description 'Only those that count (sourceCheck): nothing resting only on a narrative or project they rejected.'
  }
  careerbot.ai.extract -[reads]-> careerbot.data.tItems.facts 'proposed roles and facts, as a do-not-repeat list' {
    #unreviewedInput
    description 'Labelled as awaiting review: not to be treated as true or built on. Can still suppress a repeat while pending; rejecting one does not bring back what it covered (use Read again). Set-aside items are not sent.'
  }
  careerbot.ai.extract -[reads]-> careerbot.data.tNarratives 'their other narratives, background only' {
    #rawNarrative
    description 'Whole text of other career narratives (never the goals narrative or one they rejected), for understanding. Facts must quote the narrative being read; saveProposals flags facts whose quotes are not in it (provenance only, not truth).'
  }
  careerbot.ai.extract -[reads]-> careerbot.data.tItems.directions 'confirmed directions and limits' {
    #approvedOnly
    description 'Never the raw goals narrative, never rejected or unreviewed goals.'
  }
  careerbot.ai.extract -[reads]-> careerbot.data.tItems.facts 'rejected facts with reasons' {
    #rejectedAsGuard
    description 'Also skipped when proposed again in the same words. A Read again with Including what I rejected leaves out this narrative’s own rejections for that run only; set-aside items are never rejections.'
  }
  careerbot.ai.extract -[writes]-> careerbot.data.tItems.facts 'proposed roles, facts, context; a fact already there in the same words, in the same role or project, gains this narrative as a source instead (a set-aside one comes back for review)'

  careerbot.ai.rework -[reads]-> careerbot.data.tItems.context 'the fact, its history, approved context for its role' {
    #approvedOnly
  }
  careerbot.ai.rework -[reads]-> careerbot.data.tNarratives 'the fact’s source narrative' {
    #rawNarrative
  }
  careerbot.ai.rework -[writes]-> careerbot.data.tItems.facts 'suggestion on the fact; note and left-out details as context'

  careerbot.ai.goalsRead -[reads]-> careerbot.data.tNarratives 'the goals narrative' {
    #rawNarrative
  }
  careerbot.ai.goalsRead -[reads]-> careerbot.data.tItems.facts 'approved roles and facts' {
    #approvedOnly
  }
  careerbot.ai.goalsRead -[reads]-> careerbot.data.tItems.directions 'approved directions and limits (kept as settled)' {
    #approvedOnly
  }
  careerbot.ai.goalsRead -[reads]-> careerbot.data.tItems.limits 'rejected directions and limits' {
    #rejectedAsGuard
    description 'Told not to propose them in any wording; a limit resting only on a rejected passage is skipped in code.'
  }
  careerbot.ai.goalsRead -[writes]-> careerbot.data.tItems.directions 'proposed directions and limits (rules validated by the limit schema)'
  careerbot.ai.goalsRead -[uses]-> careerbot.core.limitSchema 'prompt spec, validation'

  careerbot.ai.limitRule -[reads]-> careerbot.data.tItems.limits 'the limit’s own wording'
  careerbot.ai.limitRule -[writes]-> careerbot.data.tItems.limits 'its filters, only if unchanged since (revision check)'
  careerbot.core.goalsApi -[calls]-> careerbot.ai.limitRule 'wording changed, filters untouched'

  careerbot.ai.check -[reads]-> careerbot.data.tItems.roles 'approved roles and facts; answered questions' {
    #approvedOnly
  }
  careerbot.ai.check -[reads]-> careerbot.data.tNarratives 'every narrative' {
    #rawNarrative
  }
  careerbot.ai.check -[writes]-> careerbot.data.tItems.questions 'open questions; overlap questions for approved jobs at different employers, without AI'
  careerbot.core.reviewApi -[writes]-> careerbot.data.tItems.questions 'overlap questions, when a role is approved, unapproved, edited, added or removed'
  careerbot.core.questionsApi -[writes]-> careerbot.data.tItems.questions 'answers (Both are right for an overlap); overlap questions again after an answer'
  careerbot.core.questionsApi -[writes]-> careerbot.data.tItems.roles 'answer; role value and its change log'

  careerbot.ui.recordScreen -[calls]-> careerbot.ai.gatherSkills 'Gather skills'
  careerbot.ui.recordScreen -[calls]-> careerbot.core.skillsApi 'Skills and tools: Edit, Merge, Keep both'
  careerbot.ui.recordScreen -[calls]-> careerbot.core.resumeApi 'Skills and tools: On resumes Show / Leave out (setSkillPresentation)'
  careerbot.ai.gatherSkills -[reads]-> careerbot.data.tItems.roles 'approved roles that count: their skills and tools' {
    #approvedOnly
  }
  careerbot.ai.gatherSkills -[reads]-> careerbot.data.tItems.projectsKind 'approved projects: their stack and languages' {
    #approvedOnly
  }
  careerbot.ai.gatherSkills -[reads]-> careerbot.data.tItems.facts 'approved facts that count' {
    #approvedOnly
  }
  careerbot.ai.gatherSkills -[reads]-> careerbot.data.tItems.skillsKind 'approved (settled) and awaiting-review skills, tools and certifications' {
    #unreviewedInput
    description 'Decision: items awaiting review are passed so they are not proposed twice and can be renamed, regrouped or offered as merges; nothing is built on them until approved.'
  }
  careerbot.ai.gatherSkills -[reads]-> careerbot.data.tItems.skillsKind 'rejected ones with reasons' {
    #rejectedAsGuard
  }
  careerbot.ai.gatherSkills -[writes]-> careerbot.data.tItems.skillsKind 'proposed items; sources added to approved ones; merge flags'
  careerbot.core.skillsApi -[writes]-> careerbot.data.tItems.skillsKind 'edit, merge, keep both; migration from role skills and tools'
  careerbot.core.skillsApi -[writes]-> careerbot.data.tResumes 'merge: skill lines and left-out choices move to the kept item'
  careerbot.core.skillsApi -[writes]-> careerbot.data.tResumeSettings 'merge: left-out choices move to the kept item'
  careerbot.core.reviewApi -[writes]-> careerbot.data.tItems.skillsKind 'approve, reject with reason, reopen, undo approval'
  careerbot.ai.resume -[reads]-> careerbot.data.tItems.skillsKind 'approved skills, tools and certifications that count (the only skills a resume lists; roles’ own skill lists are not sent)' {
    #approvedOnly
    description 'A reply’s skills are kept only as approved items (by id, or matched by name), printed with the record’s name, each once.'
  }
  careerbot.ai.duplicatesStep -[reads]-> careerbot.data.tItems.facts 'approved and awaiting-review facts, by role, with pairs kept apart' {
    #unreviewedInput
    description 'Decision: facts awaiting review are included, since a duplicate is most often a new proposal repeating an approved fact. Nothing is built on them; the only output is a flag the person resolves.'
  }
  careerbot.ai.duplicatesStep -[writes]-> careerbot.data.tItems.facts 'duplicate flags (same workspace and role; never a pair kept apart)'
