  careerbot.platform.apolloKey -[calls]-> apolloApi 'credit usage stats'

  careerbot.platform.discovery -[calls]-> careerbot.platform.screening 'after each run'
  careerbot.platform.screening -[reads]-> careerbot.data.tCompanies 'name and website only'
  careerbot.platform.screening -[writes]-> careerbot.data.tCompanies 'employer or not'
  careerbot.platform.screening -[uses]-> careerbot.platform.metering 'AI call'

  companyWebsites = external 'Company websites and job boards' {
