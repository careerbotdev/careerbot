  careerbot.platform.demo -[writes]-> careerbot.data.tUsers 'the demo\u2019s shared user, replaced at each seed'
  careerbot.platform.demo -[writes]-> careerbot.data.tWorkspaces 'the demo workspace, replaced whole at each seed'
  careerbot.platform.crons -[calls]-> careerbot.platform.demo 'hourly: clear old demo sessions'
  operator -> careerbot.platform.demo 'exports a persona run and seeds the demo (pnpm demo)'
  careerbot.platform.accounts -[writes]-> careerbot.data.tUsers
  careerbot.platform.accounts -[writes]-> careerbot.data.tSetupCodes
