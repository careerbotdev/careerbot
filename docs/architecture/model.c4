  careerbot.ui.goalsScreen -[calls]-> careerbot.ai.resume 'direction resume, tailor to a posting'
  careerbot.ui.goalsScreen -[calls]-> careerbot.core.resumeApi 'versions; title, fold and career break choices; Updates: Rewrite, Update all, Keep, Discard'
  careerbot.ai.directionsStep -[reads]-> careerbot.data.tItems.facts 'approved record, insights, limits, directions' {
    #approvedOnly
  }
  careerbot.ai.directionsStep -[reads]-> careerbot.data.tNarratives 'career narratives, background only' {
    #rawNarrative
  }
  careerbot.ai.directionsStep -[reads]-> careerbot.data.tItems.directions 'rejected and pending directions (do not repeat)' {
    #rejectedAsGuard
  }
  careerbot.ai.directionsStep -[writes]-> careerbot.data.tItems.directions 'proposed detail and criteria; suggested directions'
  careerbot.core.directionsApi -[writes]-> careerbot.data.tItems.directions
  careerbot.ai.resume -[reads]-> careerbot.data.tItems.directions 'approved positioning (direction and tailored resumes)' {
    #approvedOnly
  }
  careerbot.ai.resume -[reads]-> careerbot.data.tResumes 'the direction resume a tailored one starts from'

  careerbot.ui.resumeScreen -[calls]-> careerbot.core.profileApi 'the contact block'

  // ---- Projects from GitHub (M5.5) ----
  operator -> careerbot.platform.githubApp 'setupLink, once'
  careerbot.platform.githubApp -[calls]-> githubApi 'manifest conversion (once); app tokens; installation tokens'
  careerbot.platform.githubApp -[writes]-> careerbot.data.tGithubApp 'the app, secrets sealed'
