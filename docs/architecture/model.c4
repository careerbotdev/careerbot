  }
  careerbot.ai.revision -[reads]-> careerbot.data.tNarratives 'their other narratives, background only' {
    #rawNarrative
  }
  careerbot.ai.revision -[reads]-> careerbot.data.tItems.facts 'confirmed roles and facts' {
    #approvedOnly
    description 'Only those that count (sourceCheck).'
  }
  careerbot.ai.revision -[reads]-> careerbot.data.tItems.facts 'the facts this narrative is a source of, approved and proposed, with their ids' {
    #unreviewedInput
    description 'Every fact citing this narrative among its sources, not only those read from it first. Proposed ones are labelled as such.'
  }
  careerbot.ai.revision -[reads]-> careerbot.data.tItems.facts 'rejected facts with reasons' {
    #rejectedAsGuard
  }
  careerbot.ai.revision -[writes]-> careerbot.data.tItems.facts 'new proposals; suggestions and no-longer-said flags only on facts this narrative is a source of'

  // ---- Directions, direction and tailored resumes ----
  careerbot.ui.goalsScreen -[calls]-> careerbot.ai.directionsStep 'Fill in / Suggest more'
