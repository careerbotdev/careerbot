  careerbot.platform.yourData -[calls]-> careerbot.pursue.driveApi 'the current resumes, letters and answers, for the readable copies'
  careerbot.platform.accounts -[writes]-> careerbot.data.tMemberships 'removing someone'
  careerbot.platform.accounts -[writes]-> careerbot.data.tWorkspaces 'removing someone deletes their workspace and everything in it'
  careerbot.platform.admin -[writes]-> careerbot.data.tItems
  careerbot.platform.admin -[writes]-> careerbot.data.tNarratives
  careerbot.platform.admin -[writes]-> careerbot.data.tAiSettings
  careerbot.platform.admin -[calls]-> careerbot.ai.readProject 'a test persona’s repository read from its README, the same way without GitHub (readTrialProject)'

  // ---- Insights, follow-ups, resume, revisions ----
  careerbot.ui.insightsScreen -[calls]-> careerbot.ai.insights 'Look across my record'
  careerbot.ui.insightsScreen -[calls]-> careerbot.core.insightsApi
  careerbot.ui.insightsScreen -[calls]-> careerbot.core.reviewApi 'approve, edit, reject'
  careerbot.core.reviewApi -[calls]-> careerbot.ai.insights 'narrative fully reviewed'
  careerbot.ai.insights -[reads]-> careerbot.data.tItems.facts 'approved roles, facts, context, directions (the evidence)' {
    #approvedOnly
  }
  careerbot.ai.insights -[reads]-> careerbot.data.tNarratives 'career narratives, background only' {
    #rawNarrative
  }
  careerbot.ai.insights -[reads]-> careerbot.data.tItems.insightsKind 'approved and pending (do not repeat); rejected with reasons' {
    #rejectedAsGuard
  }
  careerbot.ai.insights -[writes]-> careerbot.data.tItems.insightsKind 'proposed insights citing approved facts (others dropped)'

  careerbot.ai.followups -[reads]-> careerbot.data.tItems.facts 'approved record' {
    #approvedOnly
  }
  careerbot.ai.followups -[reads]-> careerbot.data.tNarratives 'career narratives, background only' {
    #rawNarrative
  }
  careerbot.ai.followups -[reads]-> careerbot.data.tItems.followupsKind 'already asked, answered or set aside' {
    #rejectedAsGuard
  }
  careerbot.ai.followups -[writes]-> careerbot.data.tItems.followupsKind 'open questions'
  careerbot.core.followupsApi -[calls]-> careerbot.ai.rework 'answer about a fact'
  careerbot.core.followupsApi -[writes]-> careerbot.data.tNarratives 'answer as a note'
  careerbot.core.followupsApi -[calls]-> careerbot.ai.extract 'reads the note'

  careerbot.ui.resumeScreen -[calls]-> careerbot.ai.resume 'Write my resume'
  careerbot.ui.resumeScreen -[calls]-> careerbot.core.resumeApi 'versions; title, fold and career break choices; Updates: Rewrite, Update all, Keep, Discard'
  careerbot.core.resumeApi -[calls]-> careerbot.ai.resume 'Rewrite, Update all: a version to keep or discard'
  careerbot.core.resumeApi -[reads]-> careerbot.data.tItems.facts 'the approved record that counts, to compare with what each resume was written from'
  careerbot.core.resumeApi -[reads]-> careerbot.data.tJobs 'which resumes are being written'
  careerbot.ai.resume -[reads]-> careerbot.data.tItems.facts 'approved roles, facts, insights, context' {
    #approvedOnly
    description 'Only those that count (recordContext.countedRecord); the same items give the version its writtenFrom.'
  }
  careerbot.ai.resume -[reads]-> careerbot.data.tItems.roles 'approved career breaks, with the reason in their words' {
    #approvedOnly
  }
  careerbot.ai.resume -[writes]-> careerbot.data.tResumes 'a new version, with the overrides it starts from (bullets pinned or hidden kept where the line is the same)'
  careerbot.ai.resume -[reads]-> careerbot.data.tResumeSettings 'the length to write to: the resume’s own, else the record’s (a tailored one: its direction’s), as a target (bullets per role and in all, skills 12 to 20)' {
    #approvedOnly
    description 'The person’s own setting, not record content. The version’s writtenFrom keeps it, so a change shows in Resume updates.'
  }
  careerbot.ui.recordScreen -[calls]-> careerbot.core.resumeApi 'Resume length for every resume (setRecordLength)'
  careerbot.core.resumeApi -[reads]-> careerbot.data.tResumes
  careerbot.core.resumeApi -[writes]-> careerbot.data.tResumes 'overrides (direction and tailored); keep or discard a version from Resume updates'
  careerbot.core.resumeApi -[reads]-> careerbot.data.tResumeSettings
  careerbot.core.resumeApi -[writes]-> careerbot.data.tResumeSettings 'choices made on the base resume'
  careerbot.core.resumeApi -[reads]-> careerbot.data.tItems.roles 'approved roles’ market titles, for suggested titles'
  careerbot.core.resumeApi -[reads]-> careerbot.data.tItems.directions 'approved title map, for suggested titles'

  careerbot.ui.narrativesScreen -[calls]-> careerbot.ai.revision 'Read the changes'
