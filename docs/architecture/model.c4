  careerbot.core.projectsApi -[writes]-> careerbot.data.tItems.projectsKind 'details approved as given; linked role'
  careerbot.core.projectsApi -[calls]-> careerbot.ai.insights 'Save and approve: a project approved with nothing left to review'
  careerbot.core.reviewApi -[writes]-> careerbot.data.tItems.projectsKind 'approve (reject and reopen go through Sources)'
  careerbot.core.reviewApi -[calls]-> careerbot.core.sourcesApi 'a project rejected or reopened'
  careerbot.ui.recordScreen -[calls]-> careerbot.core.sourcesApi 'Narratives and Projects: Read again, Reject, Restore'
  careerbot.core.sourcesApi -[writes]-> careerbot.data.tNarratives 'rejectedAt'
  careerbot.core.sourcesApi -[writes]-> careerbot.data.tItems 'set aside and restored items; a project rejected or restored'
  careerbot.core.sourcesApi -[reads]-> careerbot.data.tJobs 'each source’s latest read'
  careerbot.core.sourcesApi -[calls]-> careerbot.ai.extract 'Read again: a narrative against the record now'
  careerbot.core.sourcesApi -[calls]-> careerbot.ai.readProject 'Read again: a project against the record now'
  careerbot.core.reviewApi -[calls]-> careerbot.ai.insights 'project fully reviewed'
  careerbot.ai.insights -[reads]-> careerbot.data.tItems.projectsKind 'approved projects and their approved facts' {
    #approvedOnly
    description 'A project’s facts count only while the project itself is approved, and any fact only while one of its sources stands (recordContext.sourceCheck, used by approvedRecord and every reader of the approved record).'
  }
  careerbot.ai.followups -[reads]-> careerbot.data.tItems.projectsKind 'approved projects and their approved facts' {
    #approvedOnly
  }
  careerbot.ai.directionsStep -[reads]-> careerbot.data.tItems.projectsKind 'approved projects and their approved facts' {
    #approvedOnly
  }
  careerbot.ai.resume -[reads]-> careerbot.data.tItems.projectsKind 'approved projects (name, link, dates, linked role) and their approved facts, inside the role they are linked to or under Projects' {
    #approvedOnly
    description 'Name, link, dates and linked role come from the approved project, never the reply (as shown, from the project now); a project bullet counts only that project’s approved facts; a role with a linked project written keeps its entry.'
  }
  careerbot.ai.resume -[reads]-> careerbot.data.tItems.facts 'facts connected as the same work: one fact, the lead, with the other’s words as context' {
    #approvedOnly
