  careerbot.ui.recordScreen -[calls]-> careerbot.platform.github 'Connect GitHub, repositories, Disconnect'
  careerbot.ui.recordScreen -[calls]-> careerbot.ai.readProject 'Read N repositories; how each read went'
  careerbot.platform.github -[calls]-> githubApi 'install, confirm the installation is theirs, list repositories'
  careerbot.platform.github -[uses]-> careerbot.platform.githubApp 'app token, installation token'
  careerbot.platform.github -[writes]-> careerbot.data.tGithubLinks 'connect links, the installation held'
  careerbot.platform.github -[writes]-> careerbot.data.tGithubInstalls 'kept, forgotten, repositories all or selected'
  githubApi -> careerbot.platform.github 'webhook: uninstalled, repositories changed'
  careerbot.ai.readProject -[reads]-> careerbot.data.tGithubInstalls 'their installation'
  careerbot.ai.readProject -[uses]-> careerbot.platform.githubApp 'a read-only token for that repository alone'
  careerbot.ai.readProject -[calls]-> githubApi 'git trees, file contents, commits, languages' {
    #rawNarrative
    description 'Decision: the repository is read as it is, like the narrative being read: it is the evidence, so facts must cite its files, and those citing none that was read are flagged. Never fetched: secret-looking files, dependencies, build output, lockfiles, binaries. Credentials inside what is read are redacted before it is sent.'
  }
  careerbot.ai.readProject -[reads]-> careerbot.data.tItems.facts 'this project’s approved and proposed facts, as a do-not-repeat list' {
    #unreviewedInput
    description 'Decision: proposed facts are passed so they are not proposed again; when a repository is read in parts, the final pass merges the proposals from that run into at most six project facts, which stay proposed for the person to review.'
  }
  careerbot.ai.readProject -[reads]-> careerbot.data.tItems.facts 'this project’s rejected facts with reasons' {
    #rejectedAsGuard
    description 'Also skipped when proposed again in the same words, unless a Read again includes what they rejected (that run only).'
  }
  careerbot.ai.readProject -[reads]-> careerbot.data.tItems.directions 'confirmed directions (what matters to them)' {
    #approvedOnly
  }
  careerbot.ai.readProject -[writes]-> careerbot.data.tItems.projectsKind 'proposed project; refreshed on a later read, keeping what they approved or wrote; a rejected one read again is restored with what was set aside with it'
  careerbot.ai.readProject -[writes]-> careerbot.data.tItems.facts 'proposed facts citing files, with its projectKey'
  careerbot.ui.recordScreen -[calls]-> careerbot.core.projectsApi 'Edit details, Link to a role'
  careerbot.ui.recordScreen -[calls]-> careerbot.ai.sameWorkStep 'Find same work'
  careerbot.ui.recordScreen -[calls]-> careerbot.core.sameWorkApi 'Connect, Keep separate, Disconnect'
  careerbot.core.projectsApi -[calls]-> careerbot.ai.sameWorkStep 'linked to a new role'
  careerbot.core.projectsApi -[writes]-> careerbot.data.tItems.facts 'relinked or unlinked: waiting same-work suggestions dropped'
  careerbot.ai.sameWorkStep -[reads]-> careerbot.data.tItems.projectsKind 'the approved project (name, summary, stack) and the role it is linked to' {
    #approvedOnly
  }
  careerbot.ai.sameWorkStep -[reads]-> careerbot.data.tItems.roles 'the linked approved role (title, employer, dates)' {
    #approvedOnly
  }
  careerbot.ai.sameWorkStep -[reads]-> careerbot.data.tItems.facts 'approved facts of the project and of its role that count, not yet connected, with the pairs kept separate' {
    #approvedOnly
  }
  careerbot.ai.sameWorkStep -[writes]-> careerbot.data.tItems.facts 'suggested pairs, on the project’s facts'
  careerbot.core.sameWorkApi -[writes]-> careerbot.data.tItems.facts 'connect: the pair and its lead on both facts; keep separate and disconnect: remembered on the project’s fact (disconnect also clears the pair on both)'
  careerbot.core.sameWorkApi -[reads]-> careerbot.data.tJobs 'the latest search per project'
