// CareerBot's system map: what each part does, what it reads and writes, and which inputs are filtered.
// Every Convex function and table must appear here (metadata functions / table); `pnpm arch:check` enforces it.
// Input tags on relationships: #approvedOnly (only what the person approved), #unreviewedInput (includes proposals
// they haven't reviewed), #rawNarrative (their own words, unfiltered), #rejectedAsGuard (rejected items, passed so
// they're not proposed again).
model {
  person = actor 'Job seeker' {
    description 'Writes narratives, reviews what CareerBot proposes, sets goals, models and budgets.'
  }
  operator = actor 'Operator' {
    description 'Runs admin fixes from the Convex CLI. Never reachable from a client.'
  }
  openrouter = external 'OpenRouter' {
    description 'Routes every AI call to the model the workspace chose. Billed to the person’s own key.'
  }
  oauth = external 'Google / GitHub' {
    description 'Sign-in providers.'
  }
  githubApi = external 'GitHub' {
    description 'CareerBot’s own GitHub App, separate from signing in with GitHub: read-only repository contents and metadata on the repositories each person chooses (all or some) on GitHub. The API for installations, app tokens, git trees, file contents and commits; the manifest flow that created the app; the check that an installation is the person’s own; webhooks about installations.'
  }

  googleDrive = external 'Google Drive' {
    description 'Their own Google Drive, through the Drive API with drive.file access only, and the Google Picker for choosing a folder.'
  }

  webAnalytics = external 'Cloudflare Web Analytics' {
    description 'Counts page views of the public website on careerbot.dev: the page (no query or fragment), referring site, browser, operating system, device type, country and load timings. No cookies or browser storage; Cloudflare drops the IP address at its edge. A manual install: the edge never injects the beacon.'
  }
  releasesFeed = external 'careerbot.dev releases' {
    description 'careerbot.dev/releases.json: every release\u2019s notes, newest first, as /changelog shows them. A self-hosted copy reads it once a day with a plain GET that carries nothing about the copy or its people.'
  }

  careerbot = system 'CareerBot' {

    ui = area 'Screens' {
      shell = screen 'Shell' {
        description 'The frame on every signed-in page (none when signed out). Large screens: the sidebar (Today, Review with how many decisions wait, Pursuits with how many have a reminder due, Companies, Resumes, Record with Story, Roles, Projects, Skills, Tools, Certifications, Breaks and Insights, Goals with Goals, Limits and Directions; then Activity, Settings and the account menu with Profile and Sign out), collapsible to the rail and remembered on the device. Medium: the rail. Small: the bottom bar (Today, Review, Pursuits, More, where More opens the rest in a sheet), which turns into a screen\u2019s actions, several rows\u2019 bulk actions or the choice before deleting. ⌘K reaches every screen and a screen\u2019s own commands; G then a letter moves between areas; ? shows every shortcut. Activity lists work running, waiting and paused, and what finished or failed in the last day, with Try again. Signing out forgets the drafts this browser keeps. In the demo workspace, a banner above everything (Demo: a fictional person\u2019s search; the demo workspace\u2019s person, by its name, is made up, and nothing you change is saved; Leave the demo, which signs out and goes to careerbot.dev), and every action shows This is a demo, so nothing can be changed (with Get notified) instead of reaching the server; nothing is written without a click (tours offered are kept for the visit only).'
        metadata {
          path 'every signed-in page'
        }
      }
      today = screen 'Today' {
        description 'Signed out, / is the Website; the sign-in (Invite only: Continue with Google, Continue with GitHub, and Get notified to the website’s waitlist) is at /sign-in and at any other address, and comes back to it. An account that isn’t invited is told so, with the waitlist and its email filled in (joined from sign-in), or Try another account. Signed in, the date and how many things need them, in groups: Review (how many decisions, the first groups, to Review), Pursuits (each reminder due: follow up, prepare, reply to an offer, check in; Snooze until a day), New strong roles (strong fits ranked in the last week not yet rated: Interested, Not for me with a reason), Resumes (a new version to keep or discard, or lines changed since it was written: Rewrite), Working (running work). The line opens beside the list (the pursuit, the role or the resume update). Until it is put away (Hide until later, or Show Today once every step is done; Show getting started in the \u22ef menu brings it back), Getting started shows instead, each step ticking itself off from the workspace, opening beside the list (?step=) with what it unlocks and its Learn more page under /docs/start. Setup: sign in, the OpenRouter key, AI budget and model (in place), the first story (in place, with what to cover; Talk to say it instead of typing, with the browser\u2019s own speech recognition, or where it can\u2019t, a pointer to the device\u2019s dictation; Done, read it with its cost), review, goals, the base resume (the first resume, in one sitting), the Apollo key, credits and automated Apollo work (in place), companies, and Google Drive (optional: Connect Google Drive, coming back to the step, or Skip). Once Setup is done it folds to one row and Your first pursuit follows, on the pursuit furthest along: pick a role and Start (their strongest new roles), tailor the resume, Choose a path (Outreach and Apply as check boxes, both allowed), then the steps of the path or paths chosen: Outreach, find contacts (people found, Reveal email at its cost) and send the outreach message; Apply, the cover letter and answers and apply (open the posting, Mark Applied); then Follow up. A path not chosen stays as a row, Outreach or Apply before choosing and Outreach too or Apply too after, that adds it; either path finishes it. Each opens the pursuit at its tab.'
        metadata {
          path '/ (signed in), /sign-in'
        }
      }
      reviewScreen = screen 'Review' {
        description 'Every decision waiting on them, in groups ordered by what they unlock (Directions, Limits, Direction criteria, Positioning first; then Companies to rate, Facts, Rewrites, Questions, Insights, Skills, Same work, Resume updates), each with a preview of what waits. Cards: one decision at a time with what it rests on (Built on), the next one, and keys (A, E, R, J, K, U); every negative decision asks Why? (optional) and saves the reason with it; Undo reverses the last. List: rows with checkboxes and bulk Approve and Reject; each group lists what was turned down with its reason and Restore. On a phone the card swipes and its actions sit in the bottom bar. Suggest questions in the menu. The old Follow-ups address comes here.'
        metadata {
          path '/review (?kind=, ?item=; /followups redirects to ?kind=questions)'
        }
      }
      settingsScreen = screen 'Settings' {
        description 'Sections, each with its current state: Account (sign out; on a self-hosted copy also the username, Change password, and for the owner People: everyone who can sign in, Add a person, Reset password and Remove, with the temporary password to give them, and who may use Google and GitHub), AI (one model for every task from a few recommended ones with their monthly cost; Try it; Advanced: a task\u2019s own model, the model for sorting roles, a model not listed, Compare models), Budgets and spending (meters, the AI budget, Apollo credits, automated Apollo work, to Reports), Keys (OpenRouter, Apollo with its balance, Brave: masked, Replace, Remove asks first), Companies (industries, checking companies against goals with Check all again and its cost, job postings from Apollo), Reminders, Contact and GitHub (to the base resume and Projects), Your data (Export: one ZIP of the whole workspace, what is in it and what isn\u2019t, its progress, Download for an hour and Export again; Import, only into an empty workspace: choose or drop a ZIP, its preview (which CareerBot, when, how many of each kind), Import with its progress, Continue when it stopped partway, the result with keys and connections to add again; a file too large, from a newer CareerBot or not an export is refused in plain words). Every change saves as made, with Undo.'
        metadata {
          path '/settings (?section=)'
        }
      }
      narrativesScreen = screen 'Record: Story' {
        description 'Their stories and notes: the list with how much each says and when it was read; the item with the writing edited in place (a new version when it changes) or said with Talk (\u21e7T: the browser\u2019s own speech recognition, words being heard shown greyed, saved when they stop; nothing recorded; where the browser can\u2019t, a pointer to the device\u2019s dictation), versions with restore, Read or Read new version with its cost, what a read proposed (to Review), link a story to a role, reject a story with a reason (Restore), delete (asks first), Notes. The goals story lives in Goals.'
        metadata {
          path '/record/story (?story=, ?tab=; /narratives and /narratives/[id] redirect)'
        }
      }
      recordScreen = screen 'Record: Roles' {
        description 'The timeline of roles, with career breaks as gaps and linked projects inside their role; a role\u2019s facts (approve, edit, reject with a reason, Undo approval, add a fact, add context, ask for a rewrite with its cost), its context, sources, history, same work and duplicates in place, disagreements; add or remove a role; Notes. A fact opens as a third pane (a drawer on medium, a sheet on a phone). Projects, Skills, Tools, Certifications and Breaks are their own sub-screens: Projects with GitHub (connect, choose and read repositories with their cost, disconnect), a project\u2019s facts and its role; Skills, Tools and Certifications with where each shows, merge, keep apart, classify; Breaks with how each shows on resumes.'
        metadata {
          path '/record/roles, /record/projects, /record/skills, /record/tools, /record/certifications, /record/breaks (/record redirects to /record/roles)'
        }
      }
      goalsScreen = screen 'Goals' {
        description 'The goals story edited in place with versions (restore as newest), Read my goals again with its cost, and what it produced: limits, directions and company goals, what waits in Review, what was rejected and why. Limits: firm and preference, each rule on or off, what it hides or ranks lower, a changed sentence (update the rule with its cost, or keep it), the rule\u2019s values and form, add or delete a hand-added limit, Notes. Directions: positioning, criteria, title map, fit, the direction resume, paste a posting to tailor, proposed directions, Notes.'
        metadata {
          path '/goals, /goals/limits (?limit=), /goals/directions (?direction=, ?tab=; /directions and /directions/[id] redirect)'
        }
      }
      insightsScreen = screen 'Record: Insights' {
        description 'Approved insights with the facts they rest on (a peek) and where they are used; rejected ones with the reason, reopen; approve, edit, Undo approval.'
        metadata {
          path '/record/insights (/insights redirects)'
        }
      }
      resumeScreen = screen 'Resumes' {
        description 'The base resume, one per direction, and every tailored one (frozen, with its posting and Tailor again). A resume: each line with Built on, Edit (in their own words on this resume, marked Edited, Use CareerBot\u2019s to put it back, and Check against facts with its cost: Supported, or Goes beyond with the words that do), Pin and Hide (hidden lines kept struck), the summary edited the same way by clicking it, the contact block edited in place, Layout (length, titles, folds, breaks, projects, skills; for this resume or as the default), Export (PDF, Word, copy), Write again and Add what\u2019s new with their costs (new lines from facts approved since, added or skipped one by one with a reason), History with restore and undo, two versions side by side, Notes.'
        metadata {
          path '/resumes (?resume=base | direction | tailored id; /resume and /profile redirect)'
        }
      }
      companiesScreen = screen 'Companies' {
        description 'One list with tabs Targets, Maybe, Found and Set aside (Doesn\u2019t fit your goals, Not for me with its reason, Not a place to work, each with a line saying why; nothing is deleted: Keep anyway, Restore). Rating in place: Target T, Maybe M, Not for me R with Why?, saved together. The item: about, how it fits their company goals (Built on), fit per direction, open roles into Pursuits, Start outreach (a pursuit there with no open role, for the direction it fits best, opened at People), people found there, website and job board edited in place, coverage with Check again and its cost, how it was found, Notes. The list \u22ef: Find companies (its Apollo estimate and credits left), Fill in details, Select several (bulk Check again), companies they\u2019d name, seed companies, lens settings.'
        metadata {
          path '/companies'
        }
      }
      pursuitsScreen = screen 'Pursuits' {
        description 'The main screen, an inbox of roles and pursuits: the list, the item beside it, and the tailored resume, Ask or a message as a third pane (a drawer on medium, a sheet on a phone). The address holds what is open (/pursuits?role=<posting>&direction=&status=, ?company= for one company\u2019s roles). With nothing open: By direction (started, contacted, applied, interviewed, offers, closed and why; what stands out; where roles come from, with Check again).'
        metadata {
          path '/pursuits (?role=, ?status=; /roles, /roles/[id] and /pursuits/[id] redirect there)'
        }
      }
      rolesScreen = screen 'Pursuits list' {
        description 'The list: tabs All roles, Interested, Pursuing and Closed (folding into More when narrow; with none asked for, Pursuing when any are under way); a filter bar with Direction and every role filter behind + (score, pay, place, setup, posted within, company, seniority, years asked, employment type, rating, travel, clearance, visa; each can include roles that don\u2019t say); rows with score, title, company and place, status and next step, several places folded into one row; Against your limits and Other roles folded at the end. The list \u22ef: By direction, Select several (bulk Interested, Not for me), Rank again and Check roles again with their costs, Count how big a stretch a role is, Reminders.'
        metadata {
          path '/pursuits (left pane)'
        }
      }
      roleScreen = screen 'Pursuits panel: role' {
        description 'A role not started: score, title, company, pay and place; Start (S, the one amber action), Interested (I), Not for me (R, with Why?); About the job, For you, fit per direction with Built on, the stretch, what it misses of their limits, the full description folded, Notes, and its details; the \u22ef holds Tailor a resume, Ask, open the posting and rate the company.'
        metadata {
          path '/pursuits?role=[posting]'
        }
      }
      pursuitScreen = screen 'Pursuits panel: pursuit' {
        description 'A started pursuit: status (Preparing, Contacted, Applied, In conversation, Interviewing, Offer, Closed asks why), contacted and applied dates or how far it got, Apply, Find contacts or prepare for the interview, reminders due with Snooze, and tabs Overview (next step from its path, Choose a path while it\u2019s being prepared: Outreach and Apply as two equal check boxes, both allowed; the follow-up draft when one is due: Copy and open Mail, Mark as sent, Rewrite with its cost, Built on; while outreach is quiet, Follow up with the last contact, then Next contact with People, then after three contacts Apply or Close · No response; the timeline), Role (the role as before it was started: About the job, For you, fit per direction, the stretch, the full description, notes on the role and its details beside), Resume (the tailored resume, kept as sent once applied), Letter, Answers, People (the outreach step due and its person marked Follow up or Next contact, Find contacts in three groups, Hiring manager, Team and Recruiting, move someone to another group, Add a contact by hand, Mark a reply, reveal an email at its cost, draft a message, mark sent) and Notes. A pursuit with no open role (Start outreach, at /pursuits?pursuit=) says No open role and has only Overview, Role (what the company does and the direction it\u2019s for, when either is known), People and Notes.'
        metadata {
          path '/pursuits?role=[posting], once started'
        }
      }
      reportsScreen = screen 'Reports' {
        description 'Views Overview, Spending, Search, Outcomes, Record and Activity for this month, this quarter or all time; every number says what it counts. Overview: spent against budget, pursuits started, contacted or applied (each counted apart too; a pursuit can be both), replies, new strong roles, facts approved, and each since they started. Spending: by month against budget, by task, by area, who started it (you or CareerBot), Apollo credits, per pursuit, and what is not settled yet. Search: companies found and targets over time, roles by fit per direction, the pursuit funnel by direction from started to contacted or applied to offer, time to first reply, why pursuits closed. Outcomes: contacted or applied, interviewed, offers and closed (with why), suggestions worked out from those counts (never acted on), replies by path and by contact group, interviewed of contacted or applied by direction, and interviewed of applied by the direction resume version each application was sent with. Record: stories, facts approved by week, insights, resumes kept and updated. Activity: work done and failed by kind and by day, with the failures.'
        metadata {
          path '/reports (?view=, ?period=)'
        }
      }
      compareScreen = screen 'Compare' {
        description 'Settings > AI > Compare models: up to four models on reading a story, writing the base resume or finding insights, each with its estimate before running (from the AI budget), results side by side with cost and time, past comparisons, and Use this model. Nothing is saved into the record or resumes.'
        metadata {
          path '/settings?section=ai&compare=1 (/compare redirects)'
        }
      }
      website = screen 'Website' {
        description 'Home, the public page at careerbot.dev for signed-out visitors (signed in, / is Today), led by the reader’s pains: the headline (Hundreds of job applications. No callbacks. Let’s fix that.) and a form to join the waitlist (an email; nothing is sent), Where job searches go wrong (three pains; on a phone a short list), a call to action (on a phone it takes you to the top form), Where it starts (most job tools start from your resume, CareerBot from your career: the way from your own words to what you send, between hairlines), How CareerBot fixes it (four steps in short, each a small animated tile; a few feature names linking to How it works), two cards (Open source, yours to run; It writes boldly, from what you really did), three questions (folded on a phone) with All questions, and the form again. The website is four pages, Home, How it works, Open source and Questions, plus Privacy; links between them are plain links that load the whole page (the analytics count document loads only), and Home opened at an old section address (#features, #open-source, #questions) goes to the page it moved to. Every drawing is an animated mock-up drawn in code that holds its final frame for reduced motion. Each form records where it was joined (hero, band-pains, closing on Home; how-it-works-closing, open-source-closing, questions-closing on the other pages). The header sticks to the top: on a large screen the pages (the one you’re on marked), Sign in, and Get notified (on Home once the top form is out of view, it takes you back to that form; on the other pages always, to the page’s own form at its end); narrower, Sign in and a Menu that drops the pages (the one you’re on marked) and Get notified. The footer: CareerBot elsewhere under its line (GitHub, X and LinkedIn, as their marks; careerbot.dev only), Product (the pages, Home first, then Docs, Changelog and Source on GitHub) and Account (Sign in), the AGPL-3.0 line and Privacy. Sign in goes to /sign-in. Its share card is drawn in code at build time (pnpm share:card). Each page’s head, Home’s structured data, robots.txt and the sitemap take their addresses from the build (SITE_URL); only careerbot.dev is open to search engines, and link previews work on dev too. Analytics: only in the careerbot.dev build, the public site’s frame (SiteFrame, on every page of the website and the privacy page, and the sign-in at /sign-in) loads Cloudflare Web Analytics once the visitor is known to be signed out, unless their browser sends Global Privacy Control or Do Not Track; never under the signed-in app’s frame.'
        metadata {
          path 'careerbot.dev/ (signed out)'
        }
      }
      howItWorksScreen = screen 'How it works' {
        description 'The website’s How it works page, the same for everyone, signed in or not, with no app frame: How CareerBot helps with your job search, Why isn’t your job search working?, the four steps in full (each a mock-up and the pain it answers), See where else your experience fits, Your whole search in one place (the portal; a list on a phone), It writes boldly, from what you really did, Everything CareerBot does (at #features) and the closing form (how-it-works-closing).'
        metadata {
          path '/how-it-works'
        }
      }
      openSourceScreen = screen 'Open source' {
        description 'The website’s Open source page, the same for everyone, signed in or not, with no app frame: Open source, yours to run, the licence (AGPL-3.0) and View the source on GitHub, what you need to run it (an OpenRouter key, an Apollo key, Convex, a place to run it, a way to sign in; optional Brave key) and the self-hosting guide, how it differs from the hosted version, and the closing form, Get notified when the hosted version opens (open-source-closing).'
        metadata {
          path '/open-source'
        }
      }
      questionsScreen = screen 'Questions' {
        description 'The website’s Questions page, the same for everyone, signed in or not, with no app frame: every question with its answer (once the demo is live, DEMO_URL set in the build, Can I try it first? before the last one, with Open the demo), and the closing form (questions-closing).'
        metadata {
          path '/questions'
        }
      }
      privacyScreen = screen 'Privacy' {
        description 'The public privacy page, the same for everyone, signed in or not, with no app frame: what CareerBot keeps, who else sees it (AI models through OpenRouter, Apollo and Brave, hosting, Cloudflare Web Analytics on the public pages with how to opt out), Google Drive and GitHub, the browser (no cookies from analytics, no advertising tracking, the signed-in app not measured, Talk\u2019s speech turned into text by the browser\u2019s own service with no recordings kept), the waitlist, the demo (no account, nothing typed kept, its session deleted after a day, nothing measured inside it), and how to get a copy (Settings, Your data: the whole workspace as one file, readable and importable into another copy; kept an hour) or have it deleted (privacy@careerbot.dev).'
        metadata {
          path '/privacy'
        }
      }
      docsScreen = screen 'Docs' {
        description 'The docs at /docs, public on careerbot.dev and on a self-hosted copy, signed in or not, in the website’s header and footer (Docs current; a self-hosted copy’s header has only Docs): getting started, running your own copy, how CareerBot and its AI work, using each screen, integrations, best practices, troubleshooting, contributing and reference. Large screens: a sidebar with search and the page tree, the page, and On this page. Medium and phones: a docs bar with the page tree in a sheet and search. Search (⌘K) runs in the browser over a static index (/api/search) built with the site. Each page: where it sits, its title and description, Previous and Next, and Edit this page on GitHub. Pages are MDX in content/docs, built at build time (fumadocs); the reference parts come from this model (pnpm docs:gen), and the docs check (pnpm lint) fails when they drift.'
        metadata {
          path '/docs'
        }
      }
      changelogScreen = screen 'Changelog' {
        description 'The changelog, public on careerbot.dev, the demo and every self-hosted copy (each with the releases up to its own version), signed in or not, in the website\u2019s header and footer (Changelog in the footer\u2019s Product links): the heading and its RSS feed, then each release newest first at its own address (#v0.7.0): its version and date, Read before updating when a self-hoster has steps to do, its two sentences, its docs screenshots, New, Better, Fixed, and If you host your own copy with How to update. From src/app/changelog/releases.json, written by pnpm release:prepare; the same list is /changelog/rss.xml, /releases.json, CHANGELOG.md and each GitHub Release (pnpm release:notes).'
        metadata {
          path '/changelog'
          files 'src/app/site/Changelog.tsx, src/app/changelog, src/app/releases.json/route.ts, scripts/release-notes.ts'
        }
      }
      demoEntry = screen 'Demo' {
        description 'The way into the demo at demo.careerbot.dev (a build with CAREERBOT_MODE=demo, whose only workspace is the demo): No sign-up, the heading Demo, who Renata Alvarez is (made up) and that nothing changed is saved, the one action Open the demo (signs in as the demo\u2019s shared person, no account, and lands on Today), and Want your own? Get notified when it opens (careerbot.dev\u2019s waitlist). Refused: The demo is busy. Try again in a minute. On the demo build it is what / and every other address show when signed out, the website pages are not there (the header has Docs and Open the demo), and nothing is indexed. On careerbot.dev, once the demo is live (DEMO_URL set in the build, Infisical dev and prod), /demo goes to demo.careerbot.dev/demo, Home has Open the demo under its form and Questions offers it; without DEMO_URL none of them appear. The demo runs on its own Convex deployment (careerbot project, reference demo) and its own Worker (careerbot-demo, wrangler env demo), deployed and seeded again by CI after each production release.'
        metadata {
          path '/demo (demo build: also / and every address when signed out)'
        }
      }
    }

    ai = area 'AI steps' {
      extract = aiStep 'Read a narrative' {
        description 'Turns one career narrative into proposed roles, facts and context. Every role gets at least one other title, which resumes use until the official one is given. Time away from paid work comes out as a proposed career break keyed by its start (side projects named on it, their facts on it), never an employer named after an activity. Facts keep the person’s own hedge on a number they only guessed at.'
        metadata {
          functions 'extract:start, extract:inputs, extract:saveProposals, extract:tryExtract, extract:runFor'
          model_task 'extract'
        }
      }
      rework = aiStep 'Rewrite a fact' {
        description 'Rewrites one fact from the person’s note; the note is the top authority. Result is a suggestion.'
        metadata {
          functions 'extract:rework, extract:reworkInputs, extract:saveRework, extract:tryRework'
          model_task 'rework'
        }
      }
      goalsRead = aiStep 'Read my goals' {
        description 'Turns the goals narrative into directions and bucketed limits, against the approved record.'
        metadata {
          functions 'goals:start, goals:inputs, goals:save'
          model_task 'extract'
        }
      }
      limitRule = aiStep 'Filters from wording' {
        description 'Derives a limit’s typed filters from its own edited wording only (never the narrative).'
        metadata {
          functions 'goals:limitFor, goals:setRule'
          model_task 'extract'
        }
      }
      check = aiStep 'Check for disagreements' {
        description 'Finds where narratives contradict the approved record and asks which is right. Also asks, without AI, about approved jobs at different employers whose dates overlap by three months or more (checkOverlaps): after every check, and whenever a role is approved, unapproved, edited, added or removed, or a question is answered; a pair answered Both are right is never asked again, and a question whose dates no longer overlap goes.'
        metadata {
          functions 'conflicts:start, conflicts:inputs, conflicts:save'
          model_task 'extract'
        }
      }
      gatherSkills = aiStep 'Gather skills' {
        description 'On request (Gather skills on Record): reads the approved record that counts (roles’ skills and tools, projects’ stack, approved facts) and proposes each skill, tool and certification once, named the way resumes and postings write it, with a group and where the record shows it (roles, projects, facts; anything else dropped). Vague ones are flagged low value; near-duplicates are offered as merges (an item awaiting review flagged as the same as another; never an approved one, never a pair kept apart). An item named by id or by a name they already have is that item: an approved one only gains sources, one awaiting review may be renamed, regrouped or re-kinded. A rejected one is never proposed again, in any spelling (checked in code). A run saves once.'
        metadata {
          functions 'skills:start, skills:inputs, skills:save'
          model_task 'skills'
          files 'convex/skills.ts'
        }
      }
      duplicatesStep = aiStep 'Find duplicates' {
        description 'On request only: finds facts within one role that say the same thing and flags them. Flags only facts in the workspace that share a role, never a pair the person kept apart; a new run replaces the last run’s flags.'
        metadata {
          functions 'duplicates:start, duplicates:inputs, duplicates:save'
          model_task 'duplicates'
        }
      }
      sameWorkStep = aiStep 'Find same work' {
        description 'When a project is linked to a role, and on request (Find same work on Record): suggests pairs of the project’s approved facts and its role’s approved facts that describe the same work, the richer one as lead. Only approved facts that count, of that project and role, in the workspace; never a fact already connected or a pair kept separate; each fact once. A new search replaces the project’s waiting suggestions; unlinking or relinking the project drops them.'
        metadata {
          functions 'sameWork:start, sameWork:inputs, sameWork:save'
          model_task 'sameWork'
        }
      }
      insights = aiStep 'Insights' {
        description 'Reads across the approved record and proposes what is true of the person across roles and projects; each cites approved facts, a role’s or an approved project’s alike (a project’s facts are first-class evidence). Runs after a narrative or project is fully reviewed (a project approved, by Approve or Save and approve, with none of its facts left to review; its last fact approved once the project is) and on request.'
        metadata {
          functions 'insights:start, insights:inputs, insights:save'
          model_task 'insights'
        }
      }
      followups = aiStep 'Follow-up questions' {
        description 'On request: questions whose answers would sharpen the record. Answers route to a fact rewrite or to a note that is read.'
        metadata {
          functions 'followups:start, followups:inputs, followups:save'
          model_task 'followups'
        }
      }
      resume = aiStep 'Resume' {
        description 'Structured resumes (summary, experience with bullets citing approved facts, skills) at three levels: base (neutral), direction (approved positioning), tailored (one posting, pasted or a role from the Roles page: its title, company, place and description; with no direction resume yet, it is written first in the same run; requirements map graded strong/partial/thin, and per role a title the facts support in the posting’s wording, offered as a suggestion). Every level is saved structured. Approved career breaks are entries of their own, bullets only from their own facts. Every version kept; a direction or tailored one starts with the overrides of the one it’s made from.'
        metadata {
          functions 'resume:start, resume:inputs, resume:savedBy, resume:save'
          model_task 'resume'
        }
      }
      letter = aiStep 'Cover letter' {
        description 'A cover letter for one pursuit, in the first person, from the approved record, the resume tailored to its role as it shows (the sent one, once sent) and the posting (title, company and its summary, place, description as the AI reads it), signed with their name from Profile. Paragraphs cite approved facts; a citation of anything else is dropped. Every version kept, the newest in use; their edit is a new version (a paragraph kept word for word keeps its facts). Refused before a resume is tailored to the role, while one is being written, and once the pursuit was sent. Written and edited go on the timeline.'
        metadata {
          functions 'letters:write, letters:save, letters:edit, letters:forPursuit'
          files 'convex/letters.ts'
          model_task 'letter'
        }
      }
      ask = aiStep 'Ask about this role' {
        description 'Answers in a conversation kept with each pursuit: an application question gets an answer to paste, in the first person; anything about the role, company or how to present themselves. Rests on the approved record, the resume tailored to the role as it shows (or as sent) and the posting; cites approved facts (any other citation dropped); says when the record or posting doesn\u2019t support something. One question at a time per pursuit. When their latest message tells something new about them, the model lists it as learned: that message, in their words, becomes a note narrative read into the record by Read a narrative, so what it holds arrives as proposals in the normal review queue and is never used as approved. Keep saves an answer to the pursuit\u2019s answers under the question it answered.'
        metadata {
          functions 'ask:ask, ask:conversation, ask:keep, ask:history, ask:save'
          files 'convex/ask.ts'
          model_task 'ask'
        }
      }
      outreach = aiStep 'Outreach' {
        description 'An outreach message (subject and text) from them to one contact at the pursuit\u2019s company, in four parts: who they are, why this role, why they fit (cited approved facts), and one small ask that suits the contact\u2019s group (hiring manager, team, recruiting). Knows who else they already wrote to there (a new message, not a copy) and whether they applied; with no open role, that there is none, so the ask is a conversation about the team and roles to come. Says what each part says (parts). Signed with their name. Cites approved facts; any other citation dropped. They send it from their own email (Copy and open Mail, with Download resume as a PDF beside it to attach) and mark it sent.'
        metadata {
          functions 'people:draft, people:outreachTarget, people:saveDraft'
          model_task 'outreach'
        }
      }
      followUpWriter = aiStep 'Write follow-ups' {
        description 'When an application or an outreach message goes quiet, or after an interview: a short follow-up email (subject and text) to the pursuit\u2019s contact (the person they last wrote to, else the likely hiring manager; a new follow-up goes to whoever they wrote to last), from the approved record, the role, what it follows (the application, the outreach message to this person, or both) and where the pursuit stands (status, dates, timeline, what was already sent). After an outreach message, its ask is a short call or who the right person would be. Cites approved facts; any other citation dropped. A rewrite waits beside the draft until kept. They send it from their own email (Copy and open Mail) and mark it sent: kept exactly as it was, on the timeline as Followed up, so the reminder starts over; Undo takes it back.'
        metadata {
          functions 'followUpEmails:forPursuit, followUpEmails:write, followUpEmails:keep, followUpEmails:discard, followUpEmails:edit, followUpEmails:markSent, followUpEmails:undoSent, followUpEmails:standing, followUpEmails:save'
          model_task 'followUp'
        }
      }
      lineCheck = aiStep 'Check against facts' {
        description 'On their ask only, with its estimate beside the button: a line (or the summary) they put in their own words on one resume, read beside the approved facts it rests on as the resume shows now (the summary: every entry and the facts all its lines rest on), says whether it says only what those facts support and which of its words go beyond them. One metered call with the model chosen for checking edited lines. The answer is kept with the words it checked and the facts it was checked against as they read (the resume\u2019s layout), and cleared when they edit the words again; a new version doesn\u2019t carry it. Not kept when a fact it was checked against was edited or stopped counting during the run, and not shown once one is since. Refused for words in CareerBot\u2019s, a version that isn\u2019t current, or a line on no approved facts.'
        metadata {
          functions 'lineCheck:check, lineCheck:checking, lineCheck:inputs, lineCheck:save'
          files 'convex/lineCheck.ts'
          model_task 'lineCheck'
        }
      }
      lineUpdate = aiStep 'Update lines for changed facts' {
        description 'An approved fact edited or rejected since a document was written: the lines citing it on each document in use (the base resume and each approved direction\u2019s current version, a tailored resume, cover letter and answers of a pursuit not sent) are found by the facts as the lines reflect them (the marks kept once updated, else what a base or direction resume was written from, else the fact\u2019s wording at the time from its history), and offered Update lines with its estimate. On their ask only, one metered call rewrites just those lines from the facts as they read now (a line left on no fact that counts goes; an answer always keeps an answer), with the model for resumes or for letters. The new lines wait to Apply or Discard; a line in their own words stays theirs unless they tick Use the new line. Apply changes only those lines (a resume in place with its pins, hides and own words following the line, and what it was written from taking the facts as they read; a cover letter as a new version; answers in place), holds the facts as they read, and Google Drive syncs soon after. Apply is refused, changing nothing, when a fact the new lines were written from was edited or stopped counting since, or a cited fact that didn\u2019t count then counts again. A document sent with a pursuit is never offered nor changed.'
        metadata {
          functions 'factChanges:forDocument, factChanges:documents, factChanges:update, factChanges:inputs, factChanges:save, factChanges:setUse, factChanges:discard, factChanges:apply'
          files 'convex/factChanges.ts'
          model_task 'resume, letter'
        }
      }
      readProject = aiStep 'Read a project' {
        description 'One of their GitHub repositories, read whole with a token minted for that repository alone: README, docs, product and planning documents, design and brand files (assets by name), architecture maps, in-repo trackers, changelogs, the stack from its manifests, a small code sample, and the commit history (span, count, commits per month, who committed, subjects). Secret-looking files (.env*, keys and certificates, anything named like a key, credentials) are never fetched; credentials inside what is read (key and token shapes, private key blocks, user:password in URLs, random values named like a key, secret, token or password) become [redacted] in file text and commit subjects before any call; a repository too big for one listing is listed a folder at a time; reading stops at a byte cap and splits into parts, one call each. Proposes a project (summary, stack; name, link, dates and commit count from GitHub) and facts, each citing the files it rests on (commit history for what the commits show); a fact citing no file that was read is flagged. The prompt carries the credit rule: plain and factual, the person built it, tools are tools, no framing about AI and no inflated labels. Each repository is its own job; a retried part saves nothing twice; a later read refreshes GitHub’s details and keeps what they approved or wrote.'
        metadata {
          functions 'projects:runFacts, projects:finalFacts, projects:read, projects:runs, projects:inputs, projects:save'
          model_task 'projects'
          files 'convex/projects.ts, convex/repoReader.ts'
        }
      }
      revision = aiStep 'Read the changes' {
        description 'A narrative revised after it was read: new facts, suggested updates and no-longer-said flags on this narrative’s facts only.'
        metadata {
          functions 'extract:revisionInputs, extract:saveRevision'
          model_task 'extract'
        }
      }
      directionsStep = aiStep 'Directions and search criteria' {
        description 'Per approved direction: positioning, target titles, market vocabulary, stories that carry over or need reframing (citing approved facts), title translation, and search criteria. Suggest more proposes new directions. Approved detail and criteria are never overwritten.'
        metadata {
          functions 'directions:detail, directions:suggest, directions:inputs, directions:save'
          model_task 'directions'
        }
      }
      compare = aiStep 'Compare models' {
        description 'Runs extraction with several models for judging. Nothing enters the record.'
        metadata {
          functions 'compare:start, compare:saveResult, compare:get_'
          model_task 'per contender'
        }
      }
      firstCall = aiStep 'Test call' {
        description 'A one-off prompt to check the key and model work.'
        metadata {
          functions 'jobs:start, jobs:latest'
          model_task 'firstCall'
        }
      }
    }

    core = area 'Record and goals' {
      reviewApi = service 'Record review' {
        description 'Approve, edit, reject (with reason, logged), reopen, accept/dismiss suggestions, move facts, edit roles. Undo approval (review to proposed from approved): back to review, logged on the item (undone) and in a fact’s or insight’s history; it stops counting everywhere at once, and a role-checked limit refreshes role ranks.'
        metadata {
          functions 'extract:items, extract:review, extract:edit, extract:acceptSuggestion, extract:dismissSuggestion, extract:editRole, extract:moveFact, extract:keepOrphan, extract:revertWording, extract:flagOrphan, extract:addRole, extract:removeRole, extract:addFact, extract:removeAddedFact, extract:addContext'
        }
      }
      goalsApi = service 'Goals review' {
        description 'Directions: edit (title, includes, fit), merge. Limits: one updateLimit (wording, firm, filters, scope, condition; hand-entered filters must be valid), add (in their words, or as its fields approved as given and worded from them: the Goals page adds Eligibility this way, the security clearance they hold and whether they need visa sponsorship). An edit to a direction\u2019s title or summary records when it changed, so roles ranked before it are marked.'
        metadata {
          functions 'goals:items, goals:edit, goals:merge, goals:unmerge, goals:updateLimit, goals:addLimit, goals:setLimitOn, goals:updateRule, goals:keepRule, goals:removeLimit, goals:lastRead, goals:effects, goals:hiddenBy'
        }
      }
      questionsApi = service 'Questions' {
        description 'Lists open disagreements and records the answer; an answer that changes a role is logged on it. An overlap question is answered Both are right (nothing changes) or by fixing the first job’s end or the other’s start; Undo puts the date back.'
        metadata {
          functions 'conflicts:list, conflicts:lastCheck, conflicts:answer, conflicts:reopen'
        }
      }
      skillsApi = service 'Skills and tools' {
        description 'Their skills, tools and certifications for the Record page (with where each shows, whether it counts, the item a flagged one looks like, the last gathering). Edit (name, group, kind: approved as given), Merge (one name stays, approved, with both items’ sources; the other superseded; flags, resume skill lines and left-out choices move to the kept one), Keep both (never offered as the same again). Approve, reject (with reason), reopen and undo approval go through Record review. migrate (operator, once): approved roles’ skills and tools become proposed items, one per name.'
        metadata {
          functions 'skills:list, skills:edit, skills:merge, skills:unmerge, skills:keepApart, skills:reopenPair, skills:onResumes, skills:classify, skills:migrate'
        }
      }
      sameWorkApi = service 'Same work' {
        description 'Connect: links the two facts (their text untouched); resumes then write the pair as one line from the lead, resting on both, and a version from before shows the work once. Keep separate: the pair is never suggested again. Disconnect (either side, once connected): the pair is unlinked on both facts and kept separate; resumes show both lines again as shown, no rewrite. The latest search per project.'
        metadata {
          functions 'sameWork:last, sameWork:connect, sameWork:keepSeparate, sameWork:reopen, sameWork:disconnect'
        }
      }
      duplicatesApi = service 'Duplicates' {
        description 'Merge: one wording stays approved and gains the other fact’s sources, history and notes; the other is superseded. Keep both: the pair is remembered as different and never flagged again.'
        metadata {
          functions 'duplicates:last, duplicates:merge, duplicates:unmerge, duplicates:keepBoth, duplicates:reopen'
        }
      }
      narrativesApi = service 'Narratives' {
        description 'Create, save (new version), restore, delete (facts stay, flagged; its passages leave every item that quoted it; comparisons that read it go).'
        metadata {
          functions 'narratives:list, narratives:get, narratives:create, narratives:save, narratives:restore, narratives:remove, narratives:link'
        }
      }
      limitSchema = service 'Limit schema' {
        description 'Fixed buckets and vocabularies; validation, prompt spec, display rows, job check (pass/fail/unknown). Pure module, shared with the browser.'
        metadata {
          files 'convex/limitBuckets.ts, convex/directionPaths.ts'
        }
      }
      roleDetailsSchema = service 'Role details' {
        description 'A role\u2019s details (pay, work setup, locations, seniority, years asked, employment type, travel, clearance, visa) in the limits\u2019 vocabularies; validation; the board\u2019s details merged over the AI\u2019s with where each came from; pay as yearly US dollars; words for the pages. Pure module, shared with the browser.'
        metadata {
          files 'convex/roleDetails.ts'
        }
      }
      insightsApi = service 'Insights review' {
        metadata {
          functions 'insights:list'
        }
      }
      followupsApi = service 'Follow-ups' {
        description 'Answer: a fact question becomes a rework suggestion on the fact; any other becomes a note narrative that is read. Not now (with an optional reason, kept on the question) is never asked again. reopen undoes Not now or an answer (the rework it asked for is cleared, the note it wrote set aside).'
        metadata {
          functions 'followups:list, followups:answer, followups:notNow, followups:reopen'
        }
      }
      reviewQueue = service 'Review queue' {
        description 'summary: every decision waiting, counted per group in the order that unlocks work, with a preview of what waits; the total is the count the sidebar, Today and Review show. items: one group\u2019s cards with what each rests on (approved facts, or quotes with the story and when it was written), plus what was turned down there with its reason and how to restore it. What waits is decided by shared rules the Record and Companies screens use too: fact pairs (duplicates, same work) and companies still to rate. Decisions go through each kind\u2019s own service; every negative one takes its reason in the same call, and each has an Undo (reopen, unmerge, revertWording, flagOrphan, unmerge a direction, reopen a resume version).'
        metadata {
          functions 'review:summary, review:items'
          files 'convex/review.ts, convex/reviewKinds.ts, convex/factPairs.ts, convex/companySets.ts'
        }
      }
      todayApi = service 'Today' {
        description 'roles: strong fits ranked in the last week that are neither rated nor started, best first. setup: Getting started, worked out from what the workspace holds: Setup\u2019s steps (signed in; an OpenRouter key and an AI budget; a first story; a fact approved from it; a direction or limit approved; a base resume; an Apollo key; a target company or ranked roles; Google Drive connected or skipped) with the line a done step shows; the first pursuit, the one furthest through its steps (the earliest started among equals): its path (pursuitSteps.pathOf), its tailored resume and how many requirements it covers strongly (with no open role, its direction\u2019s resume), contacts found or added, the first outreach message marked sent and to whom, its cover letter and kept answers, Applied while it is kept as sent, and when it was followed up or is due (a week after the first outreach message or the application, whichever came first); the steps they skipped; what reading a story has cost per word so far; and the workspace id that keys what the browser keeps. hideSetup puts Getting started away for the workspace or brings it back; skipStep leaves Google Drive out, or brings it back.'
        metadata {
          functions 'today:roles, today:setup, today:hideSetup, today:skipStep'
        }
      }
      toursApi = service 'Guided tours' {
        description 'A short tour of each dense screen (Today with the shell, Review, Pursuits, Companies, Resumes, Record, Goals, Settings > Google Drive), in src/app/tours, run by driver.js in the design system\u2019s look (a bottom card on a phone): each step lights up one part by its data-tour name, steps whose part isn\u2019t on screen drop out, and tours never click, spend or change anything. Every screen has Take the tour in \u2318K and its \u22ef menu; the first visit offers it once. offered lists the screens whose tour was offered for the workspace (workspaces.toursOffered); markOffered adds one. scripts/tour-check.mjs (lint) fails when a step points at a part no screen has.'
        metadata {
          functions 'tours:offered, tours:markOffered'
          files 'convex/tours.ts, src/components/Tour.ts, src/app/shell/useTour.ts, src/app/tours'
        }
      }
      activityApi = service 'Activity' {
        description 'list: the workspace\u2019s work that is queued, running or paused, and what finished or failed in the last 24 hours, each in plain words with its progress, and a way to try failed work again.'
        metadata {
          functions 'activity:list'
        }
      }
      resumeApi = service 'Resumes' {
        description 'Versions (a direction’s, or those tailored to one role, forPosting), the resume settings and the translated titles to offer (direction title map, else the record’s market title; never invented). setPresentation saves how an approved role or career break shows on every resume (fold, break shown, reason shown), judged among approved roles and breaks that count, by date; presentation reads it for the record page. setRole saves one resume’s choice for one entry: folds and breaks as that resume’s override of the record; titles on a base resume into the resume settings for every resume, on a direction or tailored resume as its override. The written resume never changes; a fold with no role on that side is refused. setProjectPresentation leaves an approved project out of every resume (or shows it again); setProject shows or leaves one out on one resume, or follows the record again (choosing what the record says stores nothing). setWords and setSummary put a line or the summary in their own words on one resume, its current version or a tailored one (its layout; the written resume never changes; a line on it twice word for word is refused), and Compare reads each version with them: the line keeps the facts it rests on and shows as edited in every format and in Drive; pins and hides still go by CareerBot\u2019s words; a new version keeps a reworded line where it has the same line, and writes its own summary. Bullets count only approved facts that still count (sourceCheck). Resume updates (updates): per base and direction resume (tailored ones are frozen), its latest version compared with the record now (resumeBasis: ids of the approved roles, facts, projects, insights and direction with a mark of their content, so a fact reworded in place shows even when counts stay the same); a version from before this was kept is unknown until rewritten. rewrite and updateAll queue resume runs whose new version waits (one at a time per resume), previewable in updates, and is never the resume until kept: not listed, downloaded, tailored from, inherited from or compared with. keep makes it the current version; discard sets it aside with an optional reason (older versions stay); reopen undoes either.'
        metadata {
          functions 'resume:list, resume:forPosting, resume:setRole, resume:setPresentation, resume:presentation, resume:setProjectPresentation, resume:setProject, resume:setSkillPresentation, resume:setSkill, resume:setBullet, resume:setWords, resume:setSummary, resume:setLength, resume:setRecordLength, resume:updates, resume:rewrite, resume:updateAll, resume:keep, resume:discard, resume:reopen, resume:overview, resume:showsFact, resume:history, resume:version, resume:compare, resume:restore, resume:undoRestore, resume:whatsNew, resume:linesInputs, resume:saveLines, resume:setLine, resume:addAll, resume:closeAdditions'
          files 'convex/resume.ts, convex/resumeBasis.ts'
        }
      }
      breaksApi = service 'Career breaks' {
        description 'Add or edit a career break (dates, reason in their words), approved as given; stored as a role with break set. Remove and restore go through Record review.'
        metadata {
          functions 'breaks:add, breaks:edit'
        }
      }
      directionsApi = service 'Directions review' {
        description 'Approve, undo the approval of (logged on the direction) or edit positioning and criteria; criteria must use the shared industry, size and stage lists. Approving, undoing or editing either records when the direction changed, so roles ranked before it are marked.'
        metadata {
          functions 'directions:list, directions:fit, directions:approvePart, directions:unapprovePart, directions:editDetail, directions:editCriteria'
        }
      }
      profileApi = service 'Contact' {
        description 'Name and contact line for downloaded resumes. Written by the person; never read by an AI step.'
        metadata {
          functions 'profile:get, profile:save'
        }
      }
      projectsApi = service 'Projects review' {
        description 'Edit a project’s name, summary and dates (approved as given); link it to one of their approved roles, or unlink it. Approve goes through Record review; reject, restore and read again through Sources.'
        metadata {
          functions 'projects:edit, projects:link, projects:setAside'
        }
      }
      sourcesApi = service 'Sources' {
        description 'Narratives (career and notes) and projects as sources of the record, acted on from its own row in Record. Reject: what it proposed that is still unreviewed is set aside (status setAside: not a rejection, never a do-not-repeat guard); what was approved from it stays approved but stops counting everywhere while none of its sources stands (recordContext.sourceCheck: a narrative not rejected, or its project while approved; an item citing several counts while any does). A proposed insight citing its facts is set aside too once none of its cited facts counts (another live fact keeps it). Restore: the source and only what was set aside with it (insights citing its facts included) come back to review; what was rejected one by one stays rejected. Read again: reads it against the record as it is now (nothing already there proposed again; its rejections kept unless Including what I rejected, for that run only). list: each narrative with its counts, set-aside count and latest read; per project, its set-aside count and latest read (set-aside insights count toward the sources of the facts they cite). extract:review routes a project’s reject and reopen here too.'
        metadata {
          functions 'sources:list, sources:reject, sources:restore, sources:readAgain'
          files 'convex/sources.ts, convex/recordContext.ts'
        }
      }
      compareApi = service 'Comparisons' {
        metadata {
          functions 'compare:list, compare:get, compare:estimate'
        }
      }
    }

    platform = area 'Platform' {
      jobs = service 'Jobs' {
        description 'Runs background work by kind; a job that hits a budget pauses and resumes. A run cut off by a deploy is picked up again every 5 minutes (up to three tries).'
        metadata {
          functions 'jobs:get, jobs:setState, jobs:markStarted, jobs:run, jobs:resumePaused, jobs:recoverStuck, jobs:checkpoint, jobs:latestTestCall, jobs:pursuitOf'
        }
      }
      metering = service 'Metering' {
        description 'Every AI call: check this month\u2019s settled spending against the budget, read the model\u2019s price (Model prices; a model without a set price is refused), then reserve the most the call could cost (its prompt at a token per byte of the request, no more than the model\u2019s context, and a reply as long as its max_tokens, at the model\u2019s highest prices, with a quarter more for a price that rose since it was read) in one step against the budget less what\u2019s settled and what calls not settled yet hold, reading the month\u2019s running total; a call that doesn\u2019t fit is refused and its job pauses (waiting on running calls, it starts again as they settle). The call is sent with that max_tokens (32,000; 96,000 for resumes, skills and directions; less when the model writes less), settled at its real cost with OpenRouter\u2019s generation id, and what it held beyond that is given back (on one of 8 shards picked at random, so calls settling at once rarely write the same row; the month\u2019s first call starts the total from the usage rows). Every AI step that reads a JSON reply goes through chatJson with its reply\u2019s own schema (the shape that step reads): for a model some provider of which keeps to one, structured output (strict JSON Schema) sent only to the providers that keep it, since JSON mode alone isn\u2019t kept by every provider, else OpenRouter\u2019s JSON mode; a schema the provider refuses as too large (Claude, for the goals reply\u2019s limit rules) is asked for again in JSON mode; a reply that stopped at its max_tokens is never read; one cut off or unreadable is asked for once more (a cut-off one with twice the max_tokens, up to the model\u2019s own most), reserved and settled like any call as \u201c<purpose>: retry\u201d, so it counts under the same task; when that fails too, the step fails with a message to try again. Decision models (Jev, through OpenRouter\u2019s Decisions API) are sent in groups that share one usage row and one reservation: each decision can cost at most the model\u2019s context in tokens at its price (Jev: 32,000 tokens at $0.042 a million, answers free), with the same quarter more, settled with the group\u2019s summed cost. Busy replies (rate limits, the in-flight spending budget) are retried after the wait OpenRouter asks for. Apollo calls reserve their credits and check them in one step. A call whose cost is uncertain (the request failed on its way, the reply named no cost, or it was cut off) is marked so and keeps what it holds; every night reconcile settles it from OpenRouter\u2019s generation lookup, or charges uncertain Apollo calls oldest first up to Apollo\u2019s own count for the cycle, and what can\u2019t be settled is marked unresolved. Each call records who started its work (they or CareerBot) and the pursuit it was for.'
        metadata {
          functions 'metering:settle, metering:unsettled, metering:workspaces, metering:reconcile, metering:resolve, metering:settleApollo, budgets:reserve, budgets:aiCheck'
        }
      }
      modelPrices = service 'Model prices' {
        description 'Each AI model\u2019s highest prices across the providers OpenRouter may route it to (per prompt token, per reply token, per request, and the long-prompt tier), the longest reply any of them writes and the longest request any of them takes (context), and whether any of them keeps a reply to a JSON schema (structured outputs), from OpenRouter\u2019s list of the model\u2019s endpoints. Kept per model and read again every hour, or when a call finds its model\u2019s missing or an hour old; when it can\u2019t be read again then, the call is refused. A model OpenRouter no longer lists is dropped. Routers whose price depends on the model they pick have no set price.'
        metadata {
          functions 'modelPrices:get, modelPrices:save, modelPrices:models, modelPrices:refresh'
        }
      }
      budgetsApi = service 'Budgets' {
        metadata {
          functions 'budgets:status, budgets:set'
        }
      }
      aiSettings = service 'AI models' {
        description 'One main model and reasoning per workspace (aiDefaults) that every task uses, chosen from a few recommended models with their price and what they would cost a month at the workspace\u2019s last 30 days of use; a task may have its own model (Advanced), and clearTask sends it back to the main one. Decision tasks (sorting roles with Jev) keep their own choice and never fall back. adoptDefault (operator, once) made each workspace\u2019s most used model its main one.'
        metadata {
          functions 'aiSettings:choiceFor, aiSettings:list, aiSettings:set, aiSettings:defaultChoice, aiSettings:setDefault, aiSettings:clearTask, aiSettings:recommended, aiSettings:usagePage, aiSettings:adoptDefault, aiSettings:catalog'
        }
      }
      apolloKey = service 'Apollo key' {
        description 'The person’s own Apollo key, sealed; checked against Apollo’s credit usage stats before saving, and the live balance shown.'
        metadata {
          functions 'apolloKey:status, apolloKey:balance, apolloKey:myWorkspace, apolloKey:save, apolloKey:store, apolloKey:remove, apolloKey:sealedFor'
        }
      }
      screening = aiStep 'Screen companies' {
        description 'Sorts found companies into places to work and non-employers (recruiters, job boards, associations, government, schools, media, investors): rules first, then a cheap AI read of name and website. Nothing deleted; the person can restore or set aside.'
        metadata {
          functions 'screening:unscreened, screening:mark, screening:setEmployer'
          model_task 'companies'
        }
      }
      enrich = aiStep 'Fill in companies' {
        description 'Free details for places to work, strongest-sourced first, in batches of 40 (fit in batches of 15; each schedules the next). A site that turns away server requests is read through Jina Reader (r.jina.ai, public URL only); with no readable site, a summary from general knowledge, labelled, only for companies the model knows. Job board found by, in order: a board link the person gave; a link on the company site or careers page; a Brave Search result that names the company or its site (optional key); a guessed board name kept only if the board page links back to the site; last, only if turned on, Apollo job postings (1 credit). Readers: Greenhouse, Lever, Ashby, Workday and Oracle Recruiting Cloud (total + a search per target title), SmartRecruiters, Breezy, Personio, Rippling, Gem, Workable, Recruitee, BambooHR, Pinpoint, Teamtailor, Jobvite, iCIMS (search pages), JazzHR, Dover. Open and remote counts and roles matching approved directions’ titles, counted only inside the approved Location limit (its countries; remote only if remote is allowed; a role naming only other countries never counts). One AI call per batch writes a one-sentence summary from site text only. Once details are in, further batches judge fit per approved-criteria direction (strong/some/weak/none with a reason) from the summary, roles, direction and approved limits. The person rates each company Excited (a target), Maybe or Not for me. Only public https hosts fetched; every redirect re-checked. With goals judgment on (the lens: Rank or Hide), the same call also judges each company against the approved company goals (fits / partly / doesn’t / can’t tell, with a reason; general knowledge of well-known companies allowed and labelled); a signal only; Keep anyway overrides; named companies are never set aside. Check again (one company or a selection) and Edit website clear that company’s details and verdicts and put it first in the next pass; Judge all again keeps details and redoes fit and goals. One pass at a time.'
        metadata {
          functions 'enrich:todo, enrich:save, enrich:next, enrich:start, enrich:setApolloJobs, enrich:saveFit, enrich:rate, enrich:keepAnyway, enrich:rejudge, enrich:recheck, enrich:setWebsite, enrich:setBoard'
          model_task 'companies'
        }
      }
      watchRoles = service 'Watch roles' {
        description 'Every open role at Targets and Maybe companies, read from their own job boards (all roles; Workday and Oracle searched by title as in enrichment; Apollo job postings only for a company found that way, and only while turned on). One pass at a time per workspace; a company they ask to check again while a pass runs is read before that pass ends (roles:finish looks and ends the pass in one write, else queues another run of it). Boards first, 10 companies a run, each scheduling the next. A role listed twice (same board id, or same title and location at one company) is one row. A role gone from a complete read is closed; a partial or failed read closes nothing. Then every open role in the Location area is queued for its next step (description, sort, judging) and 32 workers run side by side: each claims a few roles in one write, the ones nobody holds at and after a random spot in the step\u2019s queue (every queued role has a random spot), so workers claiming at once rarely reach for the same roles (no two workers hold the same role; a claim older than 10 minutes is free again), works on them, saves (a save from a worker that lost its claim is dropped) and claims again. Descriptions: 10 a claim, fetched 3 at a time, plain text (up to 8,000 characters) from the listing or each board\u2019s job detail endpoint; a role with none is marked. Sorting (Sort roles, 40 a claim) waits until every description is in, and first works out what each company repeats across its postings (a line in postings under at least 3 of its titles, or over 30% of them) and stores each description without it, the raw text kept. Judging (Rank roles) 5 a claim. Everything that goes through every role (queueing, the result, rankAgain) or every description of a company (what it repeats: counted a page of 200 at a time, then cleaned a page at a time; one worker per company at a time, the others put those roles off, and a company another worker finished meanwhile isn\u2019t worked out again) works a page at a time, so no function reads more than its limit however large a company or workspace is. A role whose own input fails (an unreadable reply, a request too long) 3 times in a pass is set aside until the next pass, with why; roles that fail together are tried alone first, and if every one fails alone the cause is taken to be ours. Any other failure (our limits and bugs, OpenRouter down) sets nothing aside and is counted for the pass; after 20 the pass stops and fails with the last one. admin:clearRoleFailures forgets recorded failures. Workers stop claiming after 6 minutes; the pass\u2019s run watches them, ends when nothing is left, pauses the pass once the AI budget refused a worker\u2019s call (budgets:reserve) and no AI call is still running, with why (workers take no more sorting or judging once it refuses; descriptions go on), stops when asked, and otherwise hands over to a new run with fresh workers. Nothing is ranked again by itself: rankAgain clears one direction\u2019s (or, with none named, every approved direction\u2019s) sort and verdicts on every open role and starts a pass that reads no boards and sorts and judges them for those directions alone. setSortMethod picks how roles are sorted (admin:setRoleSort for the operator). An operator pass (admin:startJob with only: company ids) reads, describes, sorts and judges only those companies\u2019 roles and takes the rest out of the queue; the next full pass queues them again. Each board\u2019s own details (pay, work setup, employment type, locations where the board states them: Greenhouse pay transparency, Ashby compensation, Lever salary range and workplace type, Workday time type, and the like) are kept with the role from every read and win over what judging read. Lists judged roles for one approved direction or all of them together (each at its best direction), best score then newest, filtered (score, pay as yearly US dollars, place, setup, posted within, company, seniority, years asked, employment type, rating, travel, clearance, visa; each keeps roles that don\u2019t say when asked): the database checks every filter as it reads a page except place, which is checked on a page of up to 200 rows; count (up to 2,000); roles sorted out apart, newest first, with the rule that set them aside; whether a direction changed after its roles were ranked; coverage per company (read vs board total, last read, stale after 3 days); one role with its merged details, brief, description, sort and verdicts; the person\u2019s Interested / Not for me rating. Each role\u2019s rows on the Roles page (roleRanks: one per direction and one for all directions, with what the filters read) are kept in step whenever a role opens, closes, is read, sorted, judged, ranked again or rated; every pass brings every role in step, and so does refreshRanks for one company after its rating or place-to-work call changes.'
        metadata {
          functions 'roles:stopped, roles:halt, roles:todo, roles:plan, roles:claim, roles:release, roles:progress, roles:outcome, roles:work, roles:textInput, roles:saveJobs, roles:finishRead, roles:failRead, roles:saveTexts, roles:next, roles:finish, roles:start, roles:checkCompany, roles:startAll, roles:rankAgain, roles:rankAgainRest, roles:setSortMethod, roles:setStretch, roles:list, roles:count, roles:sortedOut, roles:against, roles:overview, roles:places, roles:refreshRanks, roles:get, roles:rate, roles:sortMethodChoice'
        }
      }
      rankRoles = aiStep 'Rank roles' {
        description 'Reads each role only against the directions the sort passed it to, 5 roles an AI call, many calls at once, from the whole description without what its company repeats (the title only when there is none, and it says so), with what its board states. Per judged direction: strong, some, weak or none, a score of 0 to 100, and one plain sentence of reason, under the workspace\u2019s rubric (roleRubric.ts): v1 scores inside the level\u2019s band and gaps never lower it; v2 (Count how big a stretch a role is, on by default) keeps the level for the work alone and places the score in its band by the work, then lowers it for the stretch, possibly below the band: years asked beyond their years of work (worked out from their approved roles\u2019 dates, overlaps once, career breaks out), seniority well above theirs, core requirements their record lacks, and limits that are not firm that it misses; the stretch is listed per role in short plain words and never hides a role; a judged direction the reply leaves out is none. Per role: its details as the description states them (pay, setup, locations, seniority, years asked, employment type, travel, clearance, visa; never guessed, the board\u2019s own left out) and a brief: the job in two or three neutral sentences from the posting, and For you, why it fits and what\u2019s thin, from their approved record only. Every approved direction, their limits and their record come first in each call, the same every time, so providers can reuse them. Not a prediction of being hired; a firm limit makes it none. Busy replies are retried after the wait OpenRouter asks for. Each verdict records its method ("model"), what sorted it there, when the direction had last changed, its rubric and its stretch.'
        metadata {
          functions 'roles:judgeInput, roles:saveFit'
          model_task 'companies'
        }
      }
      sortRoles = aiStep 'Sort roles' {
        description 'Before judging, sorts each role to the approved directions it could plausibly be, or to none, leaning toward including: only those directions are judged, and a role sorted to none is not judged. One method per workspace: an AI model (Sorting roles) naming the directions of 10 roles a call, all calls at once; or Jev (Sorting roles with Jev) answering, per role, whether its main work is each direction’s work (yes or no with a probability) and which direction it is most or none of them (a probability each): a role is sorted out when Jev puts none at 0.95 or more, else it goes to each direction with a pick of 0.02 or more or a yes of 0.2 or more. Reads descriptions without the text a company repeats across its postings. roleSort:backtest (operator only) sorts the roles judged by the first full ranking and reports time, cost, recall of its strong and some verdicts, roles passed, directions per passed role and example misses (for Jev, also other rules scored from the same answers; method d1 asks Liquid AI\u2019s d1, free tier, the same questions as Jev, as a spike). sortFaceoff:faceoff (operator, spike) draws open roles at random, judges each against every approved direction as an answer key (roles:truthInput, Rank roles; paid as usage), and scores Jev and d1 on them alike; it reports within 5 minutes with what came back, and writes no verdicts.'
        metadata {
          functions 'roleSort:labelled, roleSort:texts, roleSort:backtest, sortFaceoff:openRoles, sortFaceoff:faceoff, roles:truthInput, roles:sortInput, roles:companyTexts, roles:holdCompany, roles:saveClean, roles:saveSort'
          model_task 'roleSort (AI model), roleSortJev (Jev)'
        }
      }
      tryRubric = aiStep 'Try a rubric' {
        #operatorOnly
        description 'Before a rubric is applied, judges a sample of a workspace\u2019s roles under it (roles:compareRubric) without touching their verdicts: every role they rated (Interested or Not for me), the best 30 per approved direction as the Roles page lists them, and 30 more at random among the judged roles listed. Reads what Rank roles reads, 5 roles a call, 32 calls at once, and keeps each new verdict (level, score, reason, stretch) beside the live one. rubricRun sums a run up (scores up, down and the same, mean change, levels up and down; overall, Interested and Not for me), with every rated role before and after and the biggest drops and rises. admin:applyRubric applies a rubric: the setting switches to it and every open role is ranked again.'
        metadata {
          functions 'roles:compareRubric, roles:rubricPool, roles:ratedRoles, roles:compareInput, roles:startRubricRun, roles:saveRubricRun, roles:rubricRun'
          model_task 'companies'
        }
